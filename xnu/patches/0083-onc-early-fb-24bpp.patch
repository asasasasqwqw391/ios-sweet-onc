-		for (unsigned int x = 0; x < EARLY_WIDTH; x++) {
-			line[x] = 0xff000000u;
+		unsigned int py = early_row * EARLY_CELL_H + y;
+		for (unsigned int x = 0; x < early_width; x++) {
+			early_put(x, py, 0xff000000u);
 		}
 	}
 }
