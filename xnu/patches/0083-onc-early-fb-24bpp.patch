@@ -28,13 +33,51 @@ extern unsigned char iso_font[256 * 16];
 static unsigned int early_row, early_col;
 static unsigned int early_started, early_disabled, early_panicking;
 
+/*
+ * Take the board's real splash address, geometry and bpp from boot_args.
+ * Called before the first marker so nothing can be drawn at the wrong place.
+ */
+void
+sweet_early_init(const boot_args *args)
+{
+	if (args != NULL && args->Video.v_baseAddr != 0) {
+		early_fb = (volatile uint8_t *)(uintptr_t)args->Video.v_baseAddr;
+	}
+	if (args != NULL && args->Video.v_width != 0 && args->Video.v_height != 0 &&
+	    args->Video.v_rowBytes >= args->Video.v_width * 3) {
+		unsigned long depth = args->Video.v_depth;
+
+		early_width = (unsigned int)args->Video.v_width;
+		early_height = (unsigned int)args->Video.v_height;
+		early_stride = (unsigned int)args->Video.v_rowBytes;
+		/* 24 => RGB888, 32 => ABGR8888; anything else keeps 32bpp. */
+		early_bpp = (depth == 24) ? 3u : 4u;
+	}
+}
+
+/* One pixel: 32bpp words go straight in, 24bpp is byte packed RGB888. */
+static inline void
+early_put(unsigned int x, unsigned int y, uint32_t argb)
+{
+	volatile uint8_t *p = EARLY_FB + (unsigned long)y * early_stride +
+	    (unsigned long)x * early_bpp;
+
+	if (early_bpp == 4) {
+		*(volatile uint32_t *)p = argb;
+	} else {
+		p[0] = (uint8_t)(argb >> 16);	/* R */
+		p[1] = (uint8_t)(argb >> 8);	/* G */
+		p[2] = (uint8_t)(argb);		/* B */
+	}
+}
+
