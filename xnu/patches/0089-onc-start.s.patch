diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 61b44d5..33b1e78 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -718,6 +718,21 @@ Lkernelcache_base_found:
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
 	add		x13, x25, #(2 * PGBYTES)
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
+
+	/*
+	 * onc: map the 0xBE000000 32MB block too. It is the first block past
+	 * what create_bootstrap_mapping() covered (memSize >> 25 entries), so
+	 * 0xBFEE0000/0xBFFA0000 -- where the onc early log and progress
+	 * counter live -- are otherwise UNMAPPED and fault once the MMU is on.
+	 * The block base must stay 32MB aligned.
+	 */
+	MOV64	x10, 0xBE000000
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x11, x11, x10
+	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
+	add		x13, x25, #(2 * PGBYTES)
+	str		x11, [x13, x12, lsl #TTE_SHIFT]
 Lsweet_fb_map_done:
 #endif
 
@@ -757,6 +772,13 @@ common_start:
 	ldr		x1, [x0, SR_RESTORE_TCR_EL1]
 	MSR_TCR_EL1_X1
 
+#if defined(SWEET)
+	MOV64	x9, 0xBFEE0000
+	MOV64	x8, 0x4f4e434d06
+	str	x8, [x9]
+	dsb	sy
+#endif
+
 	/* Set up translation table base registers.
 	 *	TTBR0 - V=P table @ top of kernel
 	 *	TTBR1 - KVA table @ top of kernel + 1 page
@@ -770,10 +792,24 @@ common_start:
 	mov		x19, lr
 	bl		EXT(set_mmu_ttb)
 	mov		lr, x19
+
+#if defined(SWEET)
+	MOV64	x9, 0xBFEE0000
+	MOV64	x8, 0x4f4e434d07
+	str	x8, [x9]
+	dsb	sy
+#endif
 	add		x0, x25, PGBYTES
 	and		x0, x0, #(TTBR_BADDR_MASK)
 	MSR_TTBR1_EL1_X0
 
+#if defined(SWEET)
+	MOV64	x9, 0xBFEE0000
+	MOV64	x8, 0x4f4e434d08
+	str	x8, [x9]
+	dsb	sy
+#endif
+
 	// Set up MAIR attr0 for normal memory, attr1 for device memory
 	mov		x0, xzr
 	mov		x1, #(MAIR_WRITEBACK << MAIR_ATTR_SHIFT(CACHE_ATTRINDX_WRITEBACK))
@@ -797,6 +833,13 @@ common_start:
 	tlbi	vmalle1
 	dsb		ish
 
+#if defined(SWEET)
+	MOV64	x9, 0xBFEE0000
+	MOV64	x8, 0x4f4e434d09
+	str	x8, [x9]
+	dsb	sy
+#endif
+
 
 #if defined(BCM2837)
 	// Setup timer interrupt routing; must be done before MMU is enabled
@@ -859,10 +902,24 @@ common_start:
 #endif /* HAS_APPLE_PAC */
 
 	// Enable caches, MMU, ROP and JOP
+#if defined(SWEET)
+	MOV64	x9, 0xBFEE0000
+	MOV64	x8, 0x4f4e434d10
+	str	x8, [x9]
+	dsb	sy
+#endif
 	MOV64   x0, SCTLR_EL1_DEFAULT
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
+#if defined(SWEET)
+	MOV64	x9, 0xBFEE0000
+	MOV64	x8, 0x4f4e434d11
+	str	x8, [x9]
+	dc	cvac, x9
+	dsb	sy
+#endif
+
 #if !VMAPPLE && !defined(SWEET)
 	MOV64   x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1
