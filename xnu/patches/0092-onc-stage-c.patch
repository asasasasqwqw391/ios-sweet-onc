diff --git a/osfmk/arm64/sweet_early.h b/osfmk/arm64/sweet_early.h
--- a/osfmk/arm64/sweet_early.h
+++ b/osfmk/arm64/sweet_early.h
@@ -10,6 +10,25 @@
 #if defined(SWEET)
 void sweet_early_init(const boot_args *args);
 void sweet_early_mark(unsigned int stage, const char *label);
+
+/*
+ * onc: raw boot-stage counter the shim reads back on the next boot.
+ *
+ * sweet_early_mark() paints the panel and needs a working framebuffer; the shim
+ * cannot see the panel (ABL repaints it first).  This writes one word to
+ * 0xBFEE0000 instead -- the same slot the start.s markers use.  Values are HEX
+ * and must increase.  C-level milestones start at 0x40 so they never collide
+ * with start.s's 0x06..0x11.  The block is mapped once the MMU is on
+ * (0090-onc-sweet-4k-build rounds the bootstrap block count up).
+ */
+static inline void
+onc_stage_raw(unsigned long long stage)
+{
+	*(volatile unsigned long long *)0xBFEE0000ULL = (0x4f4e434d00ULL | stage);
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+#define ONC_STAGE(n) onc_stage_raw((unsigned long long)(n))
 void sweet_early_putc(char c);
 void sweet_early_panic(const char *fmt, va_list *args);
 void sweet_early_relocate(uint64_t base);
