diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -233,6 +233,129 @@
 	__builtin_arm_isb(ISB_SY);
 #endif /* SWEET */
 }
+#elif defined(HAS_GIC_V2)
+/*
+ * GIC-400 (GICv2) support, onc port.
+ *
+ * Two security states are implemented: Group 0 belongs to TrustZone and our
+ * non-secure writes to it are ignored, so everything we care about (the
+ * architected virtual timer PPI and our IPI SGI) is put in Group 1 and therefore
+ * arrives as a normal IRQ, which is what sleh_irq() handles.
+ *
+ * interrupt acknowledgement and EOI go through the GICC MMIO frame, and the
+ * cross-CPU signal uses GICD_SGIR with TargetListFilter = all-except-self.  That
+ * avoids depending on how this SoC maps CPU interfaces onto the GIC's target
+ * list, which we have not verified.
+ */
+
+static vm_offset_t gicd_base;
+static vm_offset_t gicc_base;
+
+static uint32_t
+gic_read32(vm_offset_t addr)
+{
+	return *((volatile uint32_t *) addr);
+}
+
+static void
+gic_write32(vm_offset_t addr, uint32_t value)
+{
+	*((volatile uint32_t *) addr) = value;
+}
+
+#define gicd_read32(offset)        (gic_read32(gicd_base + (offset)))
+#define gicd_write32(offset, data) (gic_write32(gicd_base + (offset), (data)))
+#define gicc_read32(offset)        (gic_read32(gicc_base + (offset)))
+#define gicc_write32(offset, data) (gic_write32(gicc_base + (offset), (data)))
+
+/* Called from sleh_irq(): acknowledge the highest-priority pending Group 1 IRQ. */
+uint32_t
+pe_gic_ack(void)
+{
+	uint32_t iar = gicc_read32(GICC_IAR);
+	__builtin_arm_isb(ISB_SY);
+	return iar;
+}
+
+/* Called from sleh_irq(): signal end of interrupt with the IAR value. */
+void
+pe_gic_eoi(uint32_t iar)
+{
+	gicc_write32(GICC_EOIR, iar);
+	__builtin_arm_isb(ISB_SY);
+}
+
+/* Cross-CPU signal: wake every other PE with our SGI. */
+void
+pe_gic_send_ipi(void)
+{
+	__builtin_arm_dsb(DSB_ISHST);
+	gicd_write32(GICD_SGIR, GICD_SGIR_ALL_BUT_SELF | GICD_SGIR_SGI(SWEET_IPI_SGI));
+	__builtin_arm_isb(ISB_SY);
+}
+
+void
+pe_init_fiq()
+{
+	static int distributor_enabled;
+
+	if (!gicd_base) {
+		DTEntry entry;
+		void const *prop;
+		unsigned int prop_size;
+		vm_offset_t soc_base_phys;
+
+		if (SecureDTLookupEntry(NULL, "/arm-io/gic", &entry) != kSuccess) {
+			panic("%s: cannot find GIC node in DT", __func__);
+		}
+		if (SecureDTGetProperty(entry, "reg", &prop, &prop_size) != kSuccess ||
+		    prop_size < 4 * sizeof(uint64_t)) {
+			panic("%s: cannot find GIC MMIO regions in DT", __func__);
+		}
+
+		soc_base_phys = pe_arm_get_soc_base_phys();
+		gicd_base = ml_io_map(soc_base_phys + ((uint64_t const *) prop)[0],
+		    ((uint64_t const *) prop)[1]);
+		gicc_base = ml_io_map(soc_base_phys + ((uint64_t const *) prop)[2],
+		    ((uint64_t const *) prop)[3]);
+		if (!gicd_base || !gicc_base) {
+			panic("%s: cannot map GICD/GICC regions", __func__);
+		}
+		kprintf("SWEET GICv2: GICD %p GICC %p, vtimer INTID %u, SGI %u\n",
+		    (void *) gicd_base, (void *) gicc_base, SWEET_VTIMER_INTID,
+		    SWEET_IPI_SGI);
+	}
+
+	/*
+	 * SGI/PPI state is banked per CPU interface on a GICv2, so this must run on
+	 * every PE: put our SGI and the architected-timer PPI in Group 1, give them a
+	 * mid priority and enable them.
+	 */
+	gicd_write32(GICD_IGROUPR0, 0xFFFFFFFF);
+	for (unsigned int i = 0; i < 32; i += 4) {
+		gicd_write32(GICD_IPRIORITYR0 + i, 0xA0A0A0A0);
+	}
+	gicd_write32(GICD_ISENABLER0,
+	    (1U << SWEET_VTIMER_INTID) | (1U << SWEET_IPI_SGI));
+
+	/* CPU interface of this PE: enable Group 1 and unmask priorities. */
+	gicc_write32(GICC_PMR, 0xFF);
+	gicc_write32(GICC_BPR, 0);
+	uint32_t gicc_ctlr = gicc_read32(GICC_CTLR);
+	gicc_ctlr |= GICC_CTLR_ENABLEGRP1 | GICC_CTLR_ENABLEGRP1A;
+	gicc_write32(GICC_CTLR, gicc_ctlr);
+
+	/* Distributor-wide, once: enable Group 1 forwarding. */
+	if (!distributor_enabled) {
+		uint32_t gicd_ctlr = gicd_read32(GICD_CTLR);
+		gicd_ctlr |= GICD_CTLR_ENABLEGRP1 | GICD_CTLR_ENABLEGRP1A;
+		gicd_write32(GICD_CTLR, gicd_ctlr);
+		distributor_enabled = 1;
+	}
+
+	__builtin_arm_dsb(DSB_SY);
+	__builtin_arm_isb(ISB_SY);
+}
 #else
 void
 pe_init_fiq()
diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -47,7 +47,36 @@
  * GICD_SGIR for IPIs, GICC_IAR/EOIR in sleh) is the next step; see HANDOFF
  * section 20.
  */
-/* #define HAS_GIC_V3             1 */
+/*
+ * onc: this board is a GIC-400 -- **GICv2**, not GICv3.  There are no ICC_*_EL1
+ * system registers here, so the driver talks to GICD/GICC through MMIO.
+ * Base addresses come from /arm-io/gic "reg" in the ADT (0x0b000000 / 0x0b002000).
+ */
+#define HAS_GIC_V2                1
+
+#define GICD_CTLR                 0x0000
+#define GICD_TYPER                0x0004
+#define GICD_IGROUPR0             0x0080
+#define GICD_ISENABLER0           0x0100
+#define GICD_IPRIORITYR0          0x0400
+#define GICD_SGIR                 0x0F00
+
+#define GICC_CTLR                 0x0000
+#define GICC_PMR                  0x0004
+#define GICC_BPR                  0x0008
+#define GICC_IAR                  0x000C
+#define GICC_EOIR                 0x0010
+
+/* Non-secure view of a GICv2 with two security states: */
+#define GICD_CTLR_ENABLEGRP1      (1U << 0)
+#define GICD_CTLR_ENABLEGRP1A     (1U << 1)
+#define GICC_CTLR_ENABLEGRP1      (1U << 0)
+#define GICC_CTLR_ENABLEGRP1A     (1U << 1)
+
+#define GICD_SGIR_SGI(intid)      ((uint32_t)((intid) & 0xf))
+#define GICD_SGIR_ALL_BUT_SELF    (1U << 24)   /* TargetListFilter = 0b01 */
+
+#define GIC_INTID_SPURIOUS_MIN    1020
 
 #ifndef ASSEMBLER
 #define PLATFORM_PANIC_LOG_DISABLED
