diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -715,13 +715,27 @@
 	ldr		x10, [x20, #40]			/* Video.v_baseAddr */
 	cbz		x10, Lsweet_fb_map_done
 	MOV64	x12, (ARM_TT_L2_SIZE - 1)
-	bic		x10, x10, x12			/* 32MB block base */
+	bic		x10, x10, x12			/* L2 block base */
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
+	/*
+	 * onc: ONE block is not enough with 4KB pages.  An L2 block is 2MB there
+	 * (32MB with 16KB pages), while the panel is 720x1520x3 = 3.28MB, so the
+	 * marker band at the bottom of the screen (offset 1488*2160 = 3.21MB) was
+	 * outside the mapping and the first sweet_early_mark() took a data abort --
+	 * that is exactly the 0x41 reading on the device.  Map three blocks (6MB).
+	 */
+	MOV64	x14, 3				/* blocks to map */
+	MOV64	x15, ARM_TT_L2_SIZE
+Lonc_fb_map:
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
 	add		x13, x25, #(2 * PGBYTES)
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
+	add		x10, x10, x15
+	add		x11, x11, x15
+	subs	x14, x14, #1
+	b.ne		Lonc_fb_map
 
 	/*
 	 * onc: map the 0xBE000000 32MB block too. It is the first block past
