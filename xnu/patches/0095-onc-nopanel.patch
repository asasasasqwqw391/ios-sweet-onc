@@ -174,6 +174,19 @@
 	if (early_disabled || stage > 20) {
 		return;
 	}
+	/*
+	 * onc: publish the stage as 0x60|stage in DRAM instead of painting.
+	 *
+	 * The panel draw is the only reason this function touches the splash
+	 * framebuffer, and that store is what kills the kernel right after
+	 * arm_init()'s first marker (device reads 0x41 and stops, even after
+	 * 0094 widened the mapping).  The shim reads the raw word anyway, so
+	 * keep the diagnostic and drop the drawing until the boot is stable.
+	 * 0x60.. keeps these out of the 0x40..0x51 range the C milestones use.
+	 */
+	onc_stage_raw(0x60u | (unsigned long long)stage);
+	return;
+
 	uint32_t color = 0xff00ff00u | ((stage & 7u) * 32u << 16);
 	for (unsigned int y = early_height - 32; y < early_height; y++) {
 		for (unsigned int x = stage * 48; x < (stage + 1) * 48; x++) {
