diff --git a/osfmk/kern/zalloc.c b/osfmk/kern/zalloc.c
--- a/osfmk/kern/zalloc.c
+++ b/osfmk/kern/zalloc.c
@@ -160,10 +160,13 @@
 #define ZONE_GUARD_SPARSE       (64  * 1024)
 #endif /* ZSECURITY_CONFIG(SAD_FENG_SHUI) */
 
-#if XNU_PLATFORM_MacOSX
+#if XNU_PLATFORM_MacOSX && !defined(ONC_SWEET_4K)
 #define ZONE_MAP_MAX            (32ULL << 30)
 #define ZONE_MAP_VA_SIZE        (128ULL << 30)
-#else /* XNU_PLATFORM_MacOSX */
+#else /* XNU_PLATFORM_MacOSX && !defined(ONC_SWEET_4K) */
+/* onc 4KB: the ~45GB usable kernel VA gap above LOW_GLOBAL cannot host the
+ * macOS 128GB zone map claim; use the iOS sizes (the hardware has ~3GB RAM so
+ * 8GB of physical zone map is already far more than enough). */
 #define ZONE_MAP_MAX            (8ULL << 30)
 #define ZONE_MAP_VA_SIZE        (24ULL << 30)
 #endif /* !XNU_PLATFORM_MacOSX */
diff --git a/osfmk/mach/arm/vm_param.h b/osfmk/mach/arm/vm_param.h
--- a/osfmk/mach/arm/vm_param.h
+++ b/osfmk/mach/arm/vm_param.h
@@ -228,16 +228,14 @@
  */
 #if defined(ONC_SWEET_4K)
 /*
- * onc 4KB build: TTBR1 is 39-bit (T1SZ = 25), so kernel VA can start at the
- * 39-bit boundary and span ~496GB.  The stock non-large-memory layout starts
- * at -128GB and only exposes ~115GB, which is too small for the macOS-sized
- * kmem claims (the zone map alone asks for 24GB, plus IPC maps, compressor,
- * kext and pmap ranges): kmem_range_init() then panics with
- * "vm_map_locate_space failing for claim zones".  Keep VM_MAX_KERNEL_ADDRESS
- * and widen the bottom of the kernel VA range instead.
- */
-#define VM_KERNEL_POINTER_SIGNIFICANT_BITS  38
-#define VM_MIN_KERNEL_ADDRESS   ((vm_address_t) 0xffffff8000000000ULL)
+ * onc 4KB build: keep the stock non-large-memory -128GB kernel VA base.
+ *
+ * Do NOT move VM_MIN towards the 39-bit TB1 boundary: VM_PAGE_PACKED_PTR_BASE
+ * is derived from VM_MIN with a 128GB reach and the static vm_pages[] array
+ * lives at -63.9GB (see the ONC block in osfmk/vm/vm_page.h).
+ */
+#define VM_KERNEL_POINTER_SIGNIFICANT_BITS  37
+#define VM_MIN_KERNEL_ADDRESS   ((vm_address_t) 0xffffffe000000000ULL)
 #elif defined(KERNEL_INTEGRITY_KTRR) || defined(KERNEL_INTEGRITY_CTRR)
 #define VM_KERNEL_POINTER_SIGNIFICANT_BITS  38
 #define VM_MIN_KERNEL_ADDRESS   ((vm_address_t) (0ULL - GiB(144)))
diff --git a/osfmk/vm/vm_page.h b/osfmk/vm/vm_page.h
--- a/osfmk/vm/vm_page.h
+++ b/osfmk/vm/vm_page.h
@@ -485,7 +485,18 @@
 #define VM_PAGE_PACKED_ALIGNED          __attribute__((aligned(VM_PAGE_PACKED_PTR_ALIGNMENT)))
 #define VM_PAGE_PACKED_PTR_BITS         31
 #define VM_PAGE_PACKED_PTR_SHIFT        6
+#if defined(ONC_SWEET_4K)
+/*
+ * onc 4KB port: pmap_virtual_region() keeps [VM_MIN, LOW_GLOBAL) reserved, so
+ * the heap and zone map live above LOW_GLOBAL_BASE_ADDRESS (-64GB), between
+ * the physical aperture and VM_MAX.  Anchor the packing window at -64GB
+ * (VM_MIN + 64GB) so its 128GB reach covers the zone VM submap placed by
+ * zone_init() as well as the static vm_pages[] array at -63.9GB.
+ */
+#define VM_PAGE_PACKED_PTR_BASE         ((uintptr_t)(VM_MIN_KERNEL_ADDRESS + GiB(64)))
+#else
 #define VM_PAGE_PACKED_PTR_BASE         ((uintptr_t)VM_MIN_KERNEL_AND_KEXT_ADDRESS)
+#endif
 
 #define VM_PAGE_PACKED_FROM_ARRAY       0x80000000
 
