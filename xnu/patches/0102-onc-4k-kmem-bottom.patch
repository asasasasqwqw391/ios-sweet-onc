diff --git a/osfmk/vm/vm_kern.c b/osfmk/vm/vm_kern.c
--- a/osfmk/vm/vm_kern.c
+++ b/osfmk/vm/vm_kern.c
@@ -748,6 +748,21 @@
 		from_right = type_hash & KMEM_DIRECTION_MASK;
 	}
 
+#if defined(ONC_SWEET_4K)
+	/*
+	 * onc 4KB port: pmap_virtual_region() reserves the whole
+	 * [VM_MIN, LOW_GLOBAL) range, so the kernel heap only has the gap
+	 * [virtual_space_start, VM_MAX_KERNEL_ADDRESS].  The randomized front
+	 * above can be the right/top one, which puts the early kmem claim cursor
+	 * at the top of that gap and breaks kmem_range_init().  Always allocate
+	 * from the bottom of the range for ONC.
+	 *
+	 * (This only affects address selection inside kernel_map; the kmem range
+	 * pointer packing is unaffected.)
+	 */
+	from_right = false;
+#endif /* defined(ONC_SWEET_4K) */
+
 	vmk_flags->vmkf_range_id = range_id;
 	vmk_flags->vmkf_last_free = from_right;
 }
@@ -3395,6 +3410,10 @@
 	kmem_alloc(kernel_map, &kmapoff_kaddr, kmapoff_size,
 	    KMA_NOFAIL | KMA_KOBJECT | KMA_PERMANENT | KMA_VAONLY,
 	    VM_KERN_MEMORY_OSFMK);
+#if defined(ONC_SWEET_4K)
+	printf("ONC fuzz %p size=%llu\n", (void *)kmapoff_kaddr,
+	    (uint64_t)kmapoff_size);
+#endif
 	return kmapoff_kaddr + kmapoff_size;
 }
 
