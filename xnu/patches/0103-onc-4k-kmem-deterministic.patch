diff --git a/osfmk/vm/vm_kern.c b/osfmk/vm/vm_kern.c
--- a/osfmk/vm/vm_kern.c
+++ b/osfmk/vm/vm_kern.c
@@ -3673,6 +3673,23 @@
 	assert(kmem_claim_count < UINT16_MAX);
 	kmem_shuffle_claims();
 
+#if defined(ONC_SWEET_4K)
+	/*
+	 * onc 4KB port: the zone map claim is the only claim with a min_address
+	 * restriction, and its submaps must be placed inside the c_slot packing
+	 * window (-64GB .. -32GB).  Put it first so the deterministic bottom-up
+	 * placement below starts with it, just above virtual_space_start.
+	 */
+	for (uint32_t i = 1; i < kmem_claim_count; i++) {
+		if (kmem_claims[i].kc_range->min_address != 0) {
+			struct kmem_range_startup_spec tmp = kmem_claims[0];
+			kmem_claims[0] = kmem_claims[i];
+			kmem_claims[i] = tmp;
+			break;
+		}
+	}
+#endif /* defined(ONC_SWEET_4K) */
+
 	/*
 	 * Apply restrictions and determine range for each claim
 	 */
@@ -3680,6 +3697,27 @@
 		vm_map_offset_t end = 0;
 		struct kmem_range_startup_spec sp = kmem_claims[i];
 		struct mach_vm_range *sp_range = sp.kc_range;
+#if defined(ONC_SWEET_4K)
+		/*
+		 * onc 4KB port: place claims deterministically, bottom-up from
+		 * the fuzz reservation.  The generic vm_map_locate_space() path
+		 * applies the randomized kmem range policy, which for this tiny
+		 * VA layout landed the claims outside the only gap that can hold
+		 * them (zone_init() then found no temporary entry where it
+		 * expected the zone submaps).
+		 */
+		start = round_page(start);
+		if (sp_range->min_address && start > sp_range->min_address) {
+			panic("onc: claim %s at %p exceeds restriction %p",
+			    sp.kc_name, (void *)start, (void *)sp_range->min_address);
+		}
+		end = start + sp.kc_size;
+		sp_range->min_address = start;
+		sp_range->max_address = end;
+		start = end;
+		printf("ONC claim[%u] %s %p-%p\n", i, sp.kc_name,
+		    (void *)sp_range->min_address, (void *)sp_range->max_address);
+#else /* !defined(ONC_SWEET_4K) */
 		if (vm_map_locate_space(kernel_map, sp.kc_size, 0,
 		    VM_MAP_KERNEL_FLAGS_ANYWHERE(), &start, NULL) != KERN_SUCCESS) {
 			panic("kmem_range_init: vm_map_locate_space failing for claim %s",
@@ -3697,6 +3735,7 @@
 			sp_range->max_address = end;
 		}
 		start = end;
+#endif /* !defined(ONC_SWEET_4K) */
 	}
 
 	/*
@@ -3714,6 +3753,12 @@
 			panic("kmem_range_init: vm_map_find_space failing for claim %s",
 			    sp.kc_name);
 		}
+#if defined(ONC_SWEET_4K)
+		if (entry->vme_start != sp.kc_range->min_address) {
+			panic("onc: claim %s entry at %p expected %p", sp.kc_name,
+			    (void *)entry->vme_start, (void *)sp.kc_range->min_address);
+		}
+#endif
 		vm_object_reference(kernel_object);
 		VME_OBJECT_SET(entry, kernel_object, false, 0);
 		VME_OFFSET_SET(entry, entry->vme_start);
