+			    onc_hb_count, onc_irq_count, onc_vtimer_count, onc_last_intid,
+			    __builtin_arm_rsr64("CNTV_CTL_EL0"),
+			    __builtin_arm_rsr64("CNTV_TVAL_EL0"),
+			    onc_frq, __builtin_arm_rsr64("DAIF"));
+			if (onc_hb_count == 1) {
+				extern void pe_gic_dump(void);
+				pe_gic_dump();
+			}
+		}
+	}
+#endif /* defined(SWEET) */
 	/* Check for, and act on, a WFE recommendation.
