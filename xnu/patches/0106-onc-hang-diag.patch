+#if defined(SWEET)
+	/*
+	 * onc: idle heartbeat.  If a thread blocks waiting for a timer (e.g. the
+	 * IOSleep() in SweetCPU::startAll()) and the CPU goes idle, this proves
+	 * whether the idle loop keeps running and whether any interrupt -- in
+	 * particular the architected virtual timer -- is delivered.  Uses
+	 * CNTVCT/CNTFRQ, which do not depend on any interrupt being taken.
+	 */
+	{
+		extern uint64_t onc_irq_count;
+		extern uint32_t onc_last_intid;
+		extern uint64_t onc_vtimer_count;
+		static uint64_t onc_last_hb;
+		static uint32_t onc_hb_count;
+		uint64_t onc_now = __builtin_arm_rsr64("CNTVCT_EL0");
+		uint64_t onc_frq = __builtin_arm_rsr64("CNTFRQ_EL0");
+
+		if (onc_frq < 1000000) {
+			/* CNTFRQ not programmed yet (or bogus): use the board default
+			 * so the heartbeat cannot flood the console. */
+			onc_frq = 24000000;
+		}
+		if (onc_last_hb == 0 || onc_now - onc_last_hb >= onc_frq * 2) {
+			onc_last_hb = onc_now;
+			onc_hb_count++;
