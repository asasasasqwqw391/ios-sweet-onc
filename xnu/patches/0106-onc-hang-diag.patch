diff --git a/osfmk/arm64/onc_stage.h b/osfmk/arm64/onc_stage.h
new file mode 100644
--- /dev/null
+++ b/osfmk/arm64/onc_stage.h
@@ -0,0 +1,32 @@
+/*
+ * onc: kernel-stage markers that survive a hang.
+ *
+ * onc_stage_raw() stores one word (0x4f4e434d00 | stage) in the marker slot the
+ * shim reads back on the next boot ("MK max=").  Stage ranges in use:
+ *   0x06..0x11  start.s
+ *   0x40..0x51  arm_init()/arm_vm_init()            (patch 0092)
+ *   0x61..0x74  sweet_early_mark() panel markers    (0084/0085)
+ *   0x80..0x90  kernel_startup_initialize_upto()    (this patch)
+ *   0xB0..0xB8  SweetCPU::startAll()                (this patch)
+ *   0xC0..0xCC  bsd_init() / vfs_mountroot()        (this patch)
+ * Keep values inside 0x00..0xff: the shim compares the high 56 bits against
+ * 0x4f4e434d.
+ */
+#ifndef _ARM64_ONC_STAGE_H_
+#define _ARM64_ONC_STAGE_H_
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+void onc_stage_raw(unsigned long long stage);
+#ifdef __cplusplus
+}
+#endif
+
+#ifndef ONC_STAGE
+#define ONC_STAGE(n) onc_stage_raw((unsigned long long)(n))
+#endif
+
+#endif /* _ARM64_ONC_STAGE_H_ */
diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -302,6 +302,32 @@
 	gicd_write32(GICD_SGIR, GICD_SGIR_NSATT | GICD_SGIR_ALL_INCLUDING_SELF |
 	    GICD_SGIR_SGI(SWEET_IPI_SGI));
 	__builtin_arm_isb(ISB_SY);
+}
+
+/*
+ * onc: dump the GICv2 state from a hang-safe context (idle).  Reads GICC_HPPIR
+ * only -- reading GICC_IAR would acknowledge an interrupt.
+ */
+void
+pe_gic_dump(void)
+{
+	if (!gicd_base || !gicc_base) {
+		kprintf("ONC GIC: not mapped (gicd=%p gicc=%p)\n",
+		    (void *) gicd_base, (void *) gicc_base);
+		return;
+	}
+	kprintf("ONC GIC: vt=%u D_CTLR=%x EN0=%x GRP0=%x PRI%u=%x "
+	    "C_CTLR=%x PMR=%x BPR=%x HPPIR=%x\n",
+	    sweet_vtimer_intid,
+	    gicd_read32(GICD_CTLR),
+	    gicd_read32(GICD_ISENABLER0),
+	    gicd_read32(GICD_IGROUPR0),
+	    sweet_vtimer_intid,
+	    gicd_read32(GICD_IPRIORITYR0 + (sweet_vtimer_intid & ~3U)),
+	    gicc_read32(GICC_CTLR),
+	    gicc_read32(GICC_PMR),
+	    gicc_read32(GICC_BPR),
+	    gicc_read32(GICC_HPPIR));
 }
 
