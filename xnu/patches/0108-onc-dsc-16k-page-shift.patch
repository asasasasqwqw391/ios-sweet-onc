-	if ((cd->pageSize != PAGE_SHIFT_4K) && (cd->pageSize != PAGE_SHIFT)) {
+	/*
+	 * ONC (Redmi 7, 4 KB kernel pages): iOS 16's dyld shared cache carries a
+	 * 16 KB-page (shift 14) CodeDirectory.  A 4 KB kernel can never compute
+	 * those per-page hashes and the dsc page offsets are not 16 KB aligned,
+	 * so cs_validate_hash() below treats such mappings as trusted; accept
+	 * the page shift here instead of rejecting the whole blob (dyld's
+	 * fcntl(F_ADDFILESIGS) on the shared cache would otherwise fail with
+	 * EBADEXEC 85).  Normal 4 KB-signed binaries are unaffected.
+	 * See HANDOFF.md H.14.
+	 */
+	if (cd->pageSize < PAGE_SHIFT_4K || cd->pageSize > 16) {
 		printf("disallowing unsupported code signature page shift: %u\n", cd->pageSize);
 		return EBADEXEC;
 	}
@@ -5719,6 +5729,21 @@
 		if (cd != NULL) {
