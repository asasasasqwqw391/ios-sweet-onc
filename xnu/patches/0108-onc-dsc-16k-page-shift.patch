+			 * are not 16 KB aligned, which would trip the "offset not
+			 * aligned to cshash boundary" panic below.  Treat the
+			 * mapping as trusted (the dsc is Apple-signed and comes
+			 * read-only from our root filesystem) and report one 4 KB
+			 * page of progress so the caller keeps walking.  See H.14.
+			 */
+			if (blob->csb_hash_pageshift > PAGE_SHIFT) {
+				*bytes_processed = PAGE_SIZE;
+				return TRUE;
+			}
