+/*
+ * Buffer-backed surface: the same publish path as create(), for memory the
+ * kernel allocates itself (the ONC 24bpp panel needs a 32bpp shadow buffer
+ * to present into). free() drops the wired accounting because memory is an
+ * IOBufferMemoryDescriptor.
+ */
+SweetSurface *
+sweet_surface_create_buffer(uint32_t width, uint32_t height,
+    uint32_t bytesPerRow, uint32_t pixelFormat)
+{
+	SweetSurface *s = sweet_surface_alloc();
+	IOBufferMemoryDescriptor *mem = NULL;
+
+	if (s == NULL) {
+		return NULL;
+	}
+	s->width = width;
+	s->height = height;
+	s->bytesPerRow = bytesPerRow;
+	s->bytesPerElement = 4;
+	s->elementWidth = s->elementHeight = 1;
+	s->pixelFormat = pixelFormat;
+	s->allocSize = (uint32_t)round_page((uint64_t)bytesPerRow * height);
+	s->mapCache = kIOMapDefaultCache;
+	if (s->allocSize == 0 || s->allocSize > SWEET_SURFACE_MAX_ALLOC) {
+		s->release();
+		return NULL;
+	}
+	if ((uint64_t)OSAddAtomic64(s->allocSize, (volatile SInt64 *)&sweet_surface_wired) +
+	    s->allocSize <= SWEET_SURFACE_WIRED_MAX) {
+		mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+		    kIODirectionInOut | kIOMemoryKernelUserShared, s->allocSize, page_size);
+	}
+	if (mem == NULL) {
+		/* free() only accounts wired memory for buffer descriptors. */
+		OSAddAtomic64(-(SInt64)s->allocSize, (volatile SInt64 *)&sweet_surface_wired);
+		s->release();
+		return NULL;
+	}
+	bzero(mem->getBytesNoCopy(), s->allocSize);
+	s->memory = mem;
+	if (!sweet_surface_publish(s)) {
 		s->release();
 		return NULL;
 	}
