+/*
+ * Read benchmark (boot-arg emmcroot_bench=<MiB>): time a sequential read of
+ * that many MiB at the root partition's first LBA through the same CMD17
+ * primitive the filesystem uses, printing KiB/s every 4 MiB.  This separates
+ * "the card/controller is slow" from "the filesystem asks for scattered
+ * blocks": the numbers appear on the console before the HFS mount.
+ */
+static void
+oe_bench(uint32_t mib)
+{
+	uint64_t lba = oe.first_lba;
+	uint32_t blocks = mib * (1024u * 1024u / OE_BLOCK_SIZE);
+	uint32_t done = 0;
+	uint64_t t_start, t_now, t_last;
+	uint64_t nsec;
+	int rc = 0;
+
+	printf("ONC EMMC: bench start %u MiB single-block CMD17 at lba 0x%llx\n",
+	    mib, lba);
+	t_start = t_last = mach_absolute_time();
+	while (done < blocks) {
+		uint32_t n = blocks - done;
+		uint32_t i;
+
+		if (n > oe.batch_blocks) {
+			n = oe.batch_blocks;
+		}
+		for (i = 0; i < n; i++) {
+			rc = oe_read_lba(lba + done + i, oe_sector);
+			if (rc != 0) {
+				printf("ONC EMMC: bench read fail lba=0x%llx rc=%d\n",
+				    lba + done + i, rc);
+				goto out;
+			}
+		}
+		done += n;
+		if ((done % (1u * 1024u * 1024u / OE_BLOCK_SIZE)) == 0) {
+			t_now = mach_absolute_time();
+			nsec = 0;
+			absolutetime_to_nanoseconds(t_now - t_last, &nsec);
+			t_last = t_now;
+			printf("ONC EMMC: bench %u MiB: 1 MiB in %llu ms -> %llu KiB/s\n",
+			    done >> 11, (nsec + 500000ull) / 1000000ull,
+			    (uint64_t)(1 * 1024) * 1000000000ull /
+			    (nsec != 0 ? nsec : 1));
+		}
+	}
+out:
+	t_now = mach_absolute_time();
+	nsec = 0;
+	absolutetime_to_nanoseconds(t_now - t_start, &nsec);
+	printf("ONC EMMC: bench done %u KiB in %llu ms -> %llu KiB/s (rc=%d)\n",
+	    (done * OE_BLOCK_SIZE) >> 10, (nsec + 500000ull) / 1000000ull,
+	    (uint64_t)(done * OE_BLOCK_SIZE) * 1000000000ull /
+	    (nsec != 0 ? nsec : 1), rc);
 }
 
