+		oe_rd_last_ts = now;
+		printf("ONC EMMC: rd %llu KiB (+%llu KiB in %llu ms)\n",
+		    bytes >> 10, OE_RD_HEARTBEAT_BYTES >> 10,
+		    (nsec + 500000ull) / 1000000ull);
 		oe.rd_print_at = bytes + OE_RD_HEARTBEAT_BYTES;
 	}
 }
