  * been read so far.  During the dyld shared-cache load this is the only way to
- * tell "still paging in, slowly" from "wedged in the kernel".
- */
+ * tell "still paging in, slowly" from "wedged in the kernel".  The elapsed
+ * milliseconds since the previous heartbeat make a slow card obvious.
+ */
+static uint64_t oe_rd_last_ts;		/* timestamp of the previous heartbeat */
+
 static void
 oe_rd_account(uint32_t nblocks)
 {
 	uint64_t bytes;
+	uint64_t now;
 
 	oe.blocks_read += nblocks;
 	bytes = oe.blocks_read * (uint64_t)OE_BLOCK_SIZE;
 	if (bytes >= oe.rd_print_at) {
-		printf("ONC EMMC: rd %llu KiB\n", bytes >> 10);
+		uint64_t nsec = 0;
