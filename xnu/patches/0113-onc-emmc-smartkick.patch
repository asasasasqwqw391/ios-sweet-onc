 	uint32_t rdprof_left;	/* emmcroot_rdprof=N: reads left to profile */
 	bool nobranch;		/* emmcroot_nobranch=1: skip the GCC branch kick */
+	bool kick_always;	/* emmcroot_kickalways=1: old kick-per-command */
+	bool force_kick;	/* next command must kick the branch */
+	uint64_t last_cmd_end;	/* timestamp of the previous command end */
 } oe;
 
 static LCK_GRP_DECLARE(onc_emmc_grp, "onc_emmc");
@@ -350,13 +353,38 @@
  * command would then be silently dropped (measured on expU3: the HFS mount's
  * first CMD17 timed out with INT_STATUS = 0).  Called before every command.
  */
+/*
+ * The GCC apps branch is hardware-gated while the SDCC core is idle and the
+ * kick below requests it back on, but a kick after a real idle gap takes
+ * ~32 ms, which capped the read path at 15 KiB/s.  So kick only when the
+ * previous command is more than 10 ms old (a real idle gap, or the first
+ * command after init) or when a retry forces it: a steady stream of commands
+ * then runs at bus speed while idle gaps still re-enable the clock.
+ * emmcroot_nobranch=1 disables the kick completely (A/B), and
+ * emmcroot_kickalways=1 restores the old kick-per-command behaviour.
+ */
+#define OE_KICK_IDLE_NS	(10ull * 1000000ull)
+
 static void
 oe_ensure_clock(void)
 {
 	uint32_t clk;
 	uint32_t want = OE_INT_CLK_EN | OE_INT_CLK_STABLE | OE_SD_CLK_EN;
-
-	if (!oe.nobranch) {
+	bool need_kick = true;
+
+	if (oe.nobranch && !oe.force_kick) {
+		need_kick = false;
+	} else if (!oe.kick_always && !oe.force_kick &&
+	    oe.last_cmd_end != 0) {
+		uint64_t now = mach_absolute_time();
+		uint64_t nsec = 0;
+
+		absolutetime_to_nanoseconds(now - oe.last_cmd_end, &nsec);
+		if (nsec < OE_KICK_IDLE_NS) {
+			need_kick = false;
+		}
+	}
+	if (need_kick) {
 		if (oe.rdprof_left != 0) {
 			uint64_t t0 = mach_absolute_time();
 			uint64_t nsec = 0;
@@ -478,6 +506,7 @@
 	if (ist != NULL) {
 		*ist = st;
 	}
+	oe.last_cmd_end = mach_absolute_time();
 	return rc;
 }
 
@@ -712,6 +741,7 @@
 out:
 	oe_wr(oe.hc, R_INT, 0xFFFFFFFFu);
 	oe.last_int = st;
+	oe.last_cmd_end = mach_absolute_time();
 	return rc;
 }
 
@@ -766,10 +796,14 @@
 			    oe_rd(oe.hc, R_CLK) | OE_SW_RESET_CMD_DAT);
 			(void)oe_poll_clear(oe.hc, R_CLK, OE_SW_RESET_CMD_DAT,
 			    OE_CLK_TIMEOUT_NS);
+			oe.force_kick = true;
 			oe_ensure_clock();
+			oe.force_kick = false;
 			delay(2000);
 		}
+		oe.force_kick = (attempt != 0);
 		rc = oe_pio_read(cmdw, (uint32_t)lba, out);
+		oe.force_kick = false;
