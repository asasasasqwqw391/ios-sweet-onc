+			IOLog("SWEET FB: swaplog %u mask=0x%x id=0x%x,0x%x,0x%x,0x%x wh=%dx%d\n",
+			    get32(rec, 0x50), mask, get32(rec, 0x54), get32(rec, 0x58),
+			    get32(rec, 0x5c), get32(rec, 0x60),
+			    (int32_t)get32(rec + 0xc4, 8), (int32_t)get32(rec + 0xc4, 12));
+			sweet_console_muted = saved;
+		}
+	}
+
 
