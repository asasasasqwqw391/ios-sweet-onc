+/*
+ * SWEET filesystem probe (sweetfsprobe=1): the host cannot read the data
+ * volume while iOS owns it, so a kernel thread stats the keybag files and
+ * container directories that the persona/container bring-up needs and prints
+ * "FSPROBE <path> err=<errno> size=<n> mode=<octal> fileid=<n>" for each, at
+ * 120 s, 240 s and 480 s of uptime.  Off by default.
+ */
+static const char *sweet_fsprobe_paths[] = {
+	"/private/var/keybags/systembag.kb",
+	"/private/var/keybags/persona.kb",
+	"/private/var/keybags/usersession.kb",
+	"/private/var/mobile/Containers",
+	"/private/var/containers",
+	"/private/var/folders",
+	"/private/var/containers/Data/System",
+};
+
+static void
+sweet_fsprobe_dump(void)
+{
+	vfs_context_t ctx = vfs_context_create(NULL);
+
+	for (unsigned int i = 0; i < sizeof(sweet_fsprobe_paths) / sizeof(sweet_fsprobe_paths[0]); i++) {
+		const char *path = sweet_fsprobe_paths[i];
+		vnode_t vp = NULLVP;
+		struct vnode_attr va;
+		unsigned long long fileid = 0;
+		long long size = -1;
+		unsigned int mode = 0;
+		int err;
+
+		err = vnode_lookup(path, 0, &vp, ctx);
+		if (err == 0) {
+			VATTR_INIT(&va);
+			VATTR_WANTED(&va, va_mode);
+			VATTR_WANTED(&va, va_size);
+			VATTR_WANTED(&va, va_fileid);
+			err = vnode_getattr(vp, &va, ctx);
+			if (err == 0) {
+				size = (long long)va.va_size;
+				mode = (unsigned int)va.va_mode;
+				fileid = (unsigned long long)va.va_fileid;
+			}
+			vnode_put(vp);
+		}
+		printf("FSPROBE %s err=%d size=%lld mode=%o fileid=%llu\n",
+		    path, err, size, mode, fileid);
+	}
+	vfs_context_rele(ctx);
+}
+
+static void
+sweet_fsprobe_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static const int at[] = { 120, 240, 480 };
+	static int chan;
+	int enabled = 0;
+	int waited = 0;
+
+	if (!PE_parse_boot_argn("sweetfsprobe", &enabled, sizeof(enabled)) || enabled == 0) {
+		return;
+	}
+	for (unsigned int i = 0; i < sizeof(at) / sizeof(at[0]); i++) {
+		(void)tsleep(&chan, PZERO, "sweetfsp", (at[i] - waited) * hz);
+		waited = at[i];
+		printf("FSPROBE --- round %d s\n", waited);
+		sweet_fsprobe_dump();
+	}
+}
+
+void
+sweet_fsprobe_start(void)
+{
+	thread_t thread;
+
+	if (kernel_thread_start(sweet_fsprobe_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
 static void
 sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
 {
@@ -85,4 +166,5 @@
 	if (kernel_thread_start(sweet_sample_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
+	sweet_fsprobe_start();
 }
