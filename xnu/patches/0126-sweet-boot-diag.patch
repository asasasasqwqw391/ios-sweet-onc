+/*
+ * SWEET: boot-arg sweetexeclog=0 suppresses the per-exec "exec NAME" console
+ * line (default keeps it on), and sweetexecwatch=<name>[,<name>...] prints
+ * "EXECW name pid N" when a watched process is exec'd and (from exit1() in
+ * kern_exit.c) "EXITW name pid N status X" when it dies, so the life of a
+ * daemon like usermanagerd can be followed in a quiet capture.
+ */
+static int
+sweet_exec_log_enabled(void)
+{
+	static int on = -1;
+
+	if (on < 0) {
+		on = 1;
+		(void)PE_parse_boot_argn("sweetexeclog", &on, sizeof(on));
+	}
+	return on;
+}
+
+/* Shared with kern_exit.c: true when name is in sweetexecwatch. */
+int
+sweet_exec_watched(const char *name)
+{
+	static char names[128];
+	static int parsed;
+	const char *base, *comma;
+	size_t blen;
+
+	if (!parsed) {
+		parsed = 1;
+		(void)PE_parse_boot_argn("sweetexecwatch", names, sizeof(names));
+	}
+	if (names[0] == '\0') {
+		return 0;
+	}
+	base = strrchr(name, '/');
+	base = (base != NULL) ? base + 1 : name;
+	blen = strlen(base);
+	for (const char *t = names; *t != '\0';) {
+		size_t len;
+
+		comma = strchr(t, ',');
+		len = (comma != NULL) ? (size_t)(comma - t) : strlen(t);
+		if (len == blen && strncmp(t, base, len) == 0) {
+			return 1;
+		}
+		if (comma == NULL) {
+			break;
+		}
+		t = comma + 1;
 	}
 	return 0;
 }
