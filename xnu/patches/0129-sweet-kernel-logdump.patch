+/*
+ * SWEET kernel log dump (sweetlogdump=1): no userland probe can become a
+ * process on this port, so the kernel reads logd's tracev3 files and prints
+ * keyword-matched printable strings to the console.  Off by default.
+ */
+#define SWEET_LOG_DIR_DEFAULT "/private/var/db/diagnostics/Persist"
+#define SWEET_LOG_MAX_FILES       8
+#define SWEET_LOG_FILE_READ_MAX   (512 * 1024)
+#define SWEET_LOG_CHUNK           8192
+#define SWEET_LOG_DIR_BUF         8192
+#define SWEET_LOG_STR_MAX         240
+#define SWEET_LOG_STR_MIN         6
+#define SWEET_LOG_LINE_MAX        200
+#define SWEET_LOG_MAX_TIMES       8
+#define SWEET_LOG_MAX_LINES_HARD  1000
+
+static const char *sweet_log_keywords[] = {
+	"crash", "os_reason", "abort", "panic", "jetsam", "springboard",
+	"backboardd", "frontboard", "runningboard", "bkss", "systemshell",
+	"checkin", "foreground", "usersession", "persona", "container",
+	"keybag", "mobileactivation", "purplebuddy", "launchd", "watchdog",
+	"timeout", "failed", "error", "denied", "exception", "xpc", "display",
+	"scene", "surface", "present", "uid", "session", "activation", "setup",
+	"aks", "sep", "trust", "boot",
+};
+
+static char sweet_log_dir[128] = SWEET_LOG_DIR_DEFAULT;
+static int sweet_log_times[SWEET_LOG_MAX_TIMES];
+static int sweet_log_time_count = -1;
+static int sweet_log_max = 300;
+static int sweet_log_lines;
+
+static char
+sweet_log_lc(char c)
+{
+	return (c >= 'A' && c <= 'Z') ? (char)(c - 'A' + 'a') : c;
+}
+
+/* Case-insensitive substring match against the keyword list. */
+static int
+sweet_log_kw_match(const char *s)
+{
+	for (unsigned int k = 0; k < sizeof(sweet_log_keywords) / sizeof(sweet_log_keywords[0]); k++) {
+		const char *kw = sweet_log_keywords[k];
+		size_t kl = strlen(kw);
+
+		for (const char *p = s; *p != '\0'; p++) {
+			size_t i = 0;
+
+			while (i < kl && p[i] != '\0' && sweet_log_lc(p[i]) == kw[i]) {
+				i++;
+			}
+			if (i == kl) {
+				return 1;
+			}
+		}
+	}
+	return 0;
+}
+
+/* Flush one printable run: keyword-matched runs become a KLOG| line. */
+static void
+sweet_log_flush(char *run, int *runlen)
+{
+	if (*runlen >= SWEET_LOG_STR_MIN && sweet_log_lines < sweet_log_max) {
+		char out[SWEET_LOG_LINE_MAX + 1];
+		int n;
+
+		run[*runlen] = '\0';
+		if (sweet_log_kw_match(run)) {
+			n = *runlen < SWEET_LOG_LINE_MAX ? *runlen : SWEET_LOG_LINE_MAX;
+			memcpy(out, run, (size_t)n);
+			out[n] = '\0';
+			printf("KLOG| %s\n", out);
+			sweet_log_lines++;
+		}
+	}
+	*runlen = 0;
+}
+
+/* Read one tracev3 file and print its keyword-matched printable strings. */
+static void
+sweet_log_file(const char *name)
+{
+	char path[192];
+	char *buf;
+	char run[SWEET_LOG_STR_MAX + 1];
+	int runlen = 0;
+	int total = 0;
+	int err;
+	vfs_context_t ctx = vfs_context_create(NULL);
+	vnode_t vp = NULLVP;
+	struct vnode_attr va;
+
+	snprintf(path, sizeof(path), "%s/%s", sweet_log_dir, name);
+	err = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+	if (err != 0) {
+		printf("KLOG file %s err=%d\n", name, err);
+		vfs_context_rele(ctx);
+		return;
+	}
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_data_size);
+	if (vnode_getattr(vp, &va, ctx) != 0) {
+		va.va_data_size = 0;
+	}
+	printf("KLOG file %s size=%llu\n", name, (unsigned long long)va.va_data_size);
+	buf = kalloc_data(SWEET_LOG_CHUNK, Z_WAITOK);
+	if (buf == NULL) {
+		vnode_close(vp, 0, ctx);
+		vfs_context_rele(ctx);
+		return;
+	}
+	while (err == 0 && total < SWEET_LOG_FILE_READ_MAX && sweet_log_lines < sweet_log_max) {
+		int resid = SWEET_LOG_CHUNK;
+		int n;
+
+		err = vn_rdwr(UIO_READ, vp, buf, SWEET_LOG_CHUNK, total, UIO_SYSSPACE,
+		    0, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (err != 0) {
+			break;
+		}
+		n = SWEET_LOG_CHUNK - resid;
+		if (n <= 0) {
+			break;  /* EOF */
+		}
+		total += n;
+		for (int i = 0; i < n; i++) {
+			char c = buf[i];
+
+			if (c >= ' ' && c < 0x7f) {
+				if (runlen < SWEET_LOG_STR_MAX) {
+					run[runlen++] = c;
+				}
+			} else {
+				sweet_log_flush(run, &runlen);
+			}
+		}
+	}
+	sweet_log_flush(run, &runlen);
+	if (err != 0) {
+		printf("KLOG read err=%d after=%d\n", err, total);
+	}
+	kfree_data(buf, SWEET_LOG_CHUNK);
+	vnode_close(vp, 0, ctx);
+	vfs_context_rele(ctx);
+}
+
+/*
+ * Enumerate sweet_log_dir once.  dump == 0 only counts *.tracev3 files (and
+ * prints the dir error); dump == 1 prints the files and their strings.
+ */
+static int
+sweet_log_readdir(vfs_context_t ctx, int dump)
+{
+	vnode_t dvp = NULLVP;
+	char *buf;
+	off_t dir_off = 0;
+	int eofflag = 0;
+	int files = 0;
+	int err;
+
+	err = vnode_lookup(sweet_log_dir, 0, &dvp, ctx);
+	if (err != 0) {
+		if (dump == 0) {
+			printf("KLOG dir %s err=%d\n", sweet_log_dir, err);
+		}
+		return -1;
+	}
+	buf = kalloc_data(SWEET_LOG_DIR_BUF, Z_WAITOK);
+	if (buf == NULL) {
+		vnode_put(dvp);
+		return -1;
+	}
+	while (!eofflag) {
+		uio_t auio;
+		uint32_t bytes;
+		char *p;
+		char *end;
+		int numdirent = 0;
+
+		auio = uio_create(1, 0, UIO_SYSSPACE, UIO_READ);
+		if (auio == NULL) {
+			break;
+		}
+		uio_addiov(auio, (user_addr_t)(uintptr_t)buf, SWEET_LOG_DIR_BUF);
+		auio->uio_offset = dir_off;
+		err = VNOP_READDIR(dvp, auio, 0, &eofflag, &numdirent, ctx);
+		bytes = SWEET_LOG_DIR_BUF - (uint32_t)uio_resid(auio);
+		dir_off = auio->uio_offset;
+		uio_free(auio);
+		if (err != 0 || bytes == 0) {
+			break;
+		}
+		p = buf;
+		end = buf + bytes;
+		while (p + offsetof(struct dirent, d_name) <= end) {
+			struct dirent *dep = (struct dirent *)p;
+			uint16_t reclen = dep->d_reclen;
+			uint16_t namlen = dep->d_namlen;
+
+			if (reclen < offsetof(struct dirent, d_name) + 1 || p + reclen > end) {
+				break;
+			}
+			if (dep->d_ino != 0 && namlen >= 8 &&
+			    namlen <= (uint16_t)(reclen - offsetof(struct dirent, d_name) - 1) &&
+			    strncmp(dep->d_name + namlen - 8, ".tracev3", 8) == 0) {
+				files++;
+				if (dump != 0 && files <= SWEET_LOG_MAX_FILES &&
+				    sweet_log_lines < sweet_log_max) {
+					sweet_log_file(dep->d_name);
+				}
+			}
+			p += reclen;
+		}
+	}
+	kfree_data(buf, SWEET_LOG_DIR_BUF);
+	vnode_put(dvp);
+	return files;
+}
+
+static void
+sweet_log_parse_times(const char *list)
+{
+	const char *p = list;
+
+	sweet_log_time_count = 0;
+	while (*p != '\0' && sweet_log_time_count < SWEET_LOG_MAX_TIMES) {
+		int v = 0;
+		int digits = 0;
+
+		while (*p >= '0' && *p <= '9') {
+			v = v * 10 + (int)(*p - '0');
+			p++;
+			digits++;
+		}
+		if (digits != 0) {
+			sweet_log_times[sweet_log_time_count++] = v;
+		}
+		if (*p == ',') {
+			p++;
+		} else if (*p != '\0') {
+			break;
+		}
+	}
+}
+
+static void
+sweet_log_dump(int round)
+{
+	vfs_context_t ctx;
+	int files;
+
+	ctx = vfs_context_create(NULL);
+	sweet_log_lines = 0;
+	files = sweet_log_readdir(ctx, 0);
+	if (files < 0) {
+		vfs_context_rele(ctx);
+		return;
+	}
+	printf("KLOG --- dump %d at %llu s: %d tracev3 files\n", round,
+	    (unsigned long long)sweet_dump_uptime_sec(), files);
+	if (files > 0 && sweet_log_lines < sweet_log_max) {
+		(void)sweet_log_readdir(ctx, 1);
+	}
+	printf("KLOG end %d lines\n", sweet_log_lines);
+	vfs_context_rele(ctx);
+}
+
+static void
+sweet_logdump_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	char times[96];
+	char dir[128];
+	int on = 0;
+	int max = 0;
+
+	if (!PE_parse_boot_argn("sweetlogdump", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	if (!PE_parse_boot_argn("sweetlogtimes", times, sizeof(times))) {
+		strlcpy(times, "240,420", sizeof(times));
+	}
+	if (PE_parse_boot_argn("sweetlogdir", dir, sizeof(dir)) && dir[0] != '\0') {
+		strlcpy(sweet_log_dir, dir, sizeof(sweet_log_dir));
+	}
+	if (PE_parse_boot_argn("sweetlogmax", &max, sizeof(max)) && max > 0) {
+		sweet_log_max = max > SWEET_LOG_MAX_LINES_HARD ? SWEET_LOG_MAX_LINES_HARD : max;
+	}
+	sweet_log_parse_times(times);
+	if (sweet_log_time_count <= 0) {
+		return;
+	}
+	for (int i = 0; i < sweet_log_time_count; i++) {
+		sweet_dump_sleep_until((uint64_t)sweet_log_times[i]);
+		sweet_log_dump(i + 1);
+	}
+}
+
+void
+sweet_logdump_start(void)
+{
+	thread_t thread;
+
+	if (kernel_thread_start(sweet_logdump_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
 static void
 sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
 {
@@ -409,4 +720,5 @@
 	}
 	sweet_fsprobe_start();
 	sweet_dumpfile_start();
-}
+	sweet_logdump_start();
+}
