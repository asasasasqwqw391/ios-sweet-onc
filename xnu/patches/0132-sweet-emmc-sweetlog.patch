 			printf("ONC EMMC: sampler on for %s\n", smp);
 		}
 	}
+	/* Persistent console log (SWEETLOG) + optional scheduled reset. */
+	if (oe.nblocks > 2 * SWEET_EMMC_LOG_LBAS) {
+		sweet_emmc_extras_start();
+	} else {
+		printf("SWEET LOG: partition too small for the log tail, disabled\n");
+	}
 	return 0;
 
