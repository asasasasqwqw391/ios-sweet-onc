+/*
+ * Clear the Android bootloader BCB in `misc` (0x600d, "boot-recovery") very
+ * early in the eMMC init, so that the NEXT reset does not return to the
+ * recovery partition (our iOS image) but boots `boot` (TWRP).  Only the
+ * bootloader_message area at the start of `misc` is zeroed: 4096 bytes =
+ * 8 x 512-byte blocks.  Disabled with sweetclearmisc=0.
+ */
+#define SWEET_MISC_CLEAR_BYTES 4096u
+
+static void
+sweet_clear_misc_bcb(void)
+{
+	uint8_t zero[OE_BLOCK_SIZE];
+	uint32_t on = 1;
+	uint32_t i;
+	int error = 0;
+
+	if (PE_parse_boot_argn("sweetclearmisc", &on, sizeof(on)) && on == 0) {
+		printf("SWEET MISC: clearing disabled by sweetclearmisc=0\n");
+		return;
+	}
+	if (!oe.writable) {
+		printf("SWEET MISC: eMMC is read-only, BCB not cleared\n");
+		return;
+	}
+	if (oe.misc_lba == 0 ||
+	    oe.misc_nblocks < SWEET_MISC_CLEAR_BYTES / OE_BLOCK_SIZE) {
+		printf("SWEET MISC: misc partition not found or too small, BCB not cleared\n");
+		return;
+	}
+	memset(zero, 0, sizeof(zero));
+	lck_mtx_lock(&onc_emmc_lock);
+	for (i = 0; i < SWEET_MISC_CLEAR_BYTES / OE_BLOCK_SIZE && error == 0; i++) {
+		error = oe_write_lba(oe.misc_lba + i, zero);
+	}
+	lck_mtx_unlock(&onc_emmc_lock);
+	if (error != 0) {
+		printf("SWEET MISC: clear failed (%d) at block 0x%llx\n", error,
+		    oe.misc_lba);
+	} else {
+		printf("SWEET MISC: cleared BCB at block 0x%llx\n", oe.misc_lba);
+	}
+}
+
+
 /* -------------------------------------------------------------------------
  * Init and the root-device entry point
  * ---------------------------------------------------------------------- */
