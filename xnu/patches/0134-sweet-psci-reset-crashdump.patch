+/*
+ * PSCI SYSTEM_RESET for the scheduled reboot (0132 sweetrebootat).
+ *
+ * reboot_kernel() -> halt_all_cpus(TRUE) -> PEHaltRestart(kPERestartCPU)
+ * ends in PE_halt_restart, which is NULL on this platform: the device prints
+ * "launchd quiesce complete" and then never resets.  The SMC conduit is known
+ * good (patch 0065 uses it for PSCI CPU_ON), so the failsafe and the
+ * sweetpscireset test path call PSCI SYSTEM_RESET directly.  SMCCC 1.0:
+ * x1-x17 may be clobbered; x0 is the (signed) PSCI result if it ever returns.
+ */
+static void
+sweet_psci_system_reset(void)
+{
+	register uint64_t x0 __asm__("x0") = 0x84000009ULL;
+
+	printf("SWEET RESET: PSCI SYSTEM_RESET\n");
+	__asm__ volatile("smc #0" : "+r"(x0) : :
+	    "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10",
+	    "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+	/* PSCI SYSTEM_RESET does not return; park here if it did. */
+	printf("SWEET RESET: PSCI returned 0x%llx, parked\n",
+	    (unsigned long long)x0);
+	for (;;) {
+		delay(1000000);
+	}
+}
+
+/* 45 s after "firing now": force a reset even if the clean path hangs. */
+static void
+sweet_psci_failsafe_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+
+	(void)tsleep(&chan, PZERO, "sweetpsi", hz * 45);
+	printf("SWEET RESET: failsafe firing (45 s, clean shutdown hung)\n");
+	sweet_psci_system_reset();
+}
+
+/* sweetpscireset=<secs>: direct PSCI reset test, no XNU shutdown. */
+static void
+sweet_pscireset_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	uint32_t secs = 0;
+
+	if (!PE_parse_boot_argn("sweetpscireset", &secs, sizeof(secs)) || secs == 0) {
+		return;
+	}
+	printf("SWEET RESET: armed for %u s (PSCI SYSTEM_RESET)\n", secs);
+	(void)tsleep(&chan, PZERO, "sweetpsr", hz * (int)secs);
+	sweet_psci_system_reset();
 }
 
 
