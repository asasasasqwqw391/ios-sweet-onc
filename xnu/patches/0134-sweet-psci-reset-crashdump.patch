+/*
+ * SWEET crash-report tree dumper (sweetdumptree=<dir>[,<dir>...]).
+ *
+ * The GUI wall is a SpringBoard SIGABRT, and the .ips report on the iOS
+ * volume has the exception backtrace.  After the root volume is mounted
+ * (sweetdumptreetime, default 120 s) list each directory with VNOP_READDIR
+ * (kernel struct dirent = 32-bit-ino layout under KERNEL) and dump the text of
+ * matching regular files to the console; SWEETLOG (0132) then carries it to
+ * the TWRP pull.  Off unless sweetdumptree is set.
+ */
+#define SWEET_TREE_MAX_DIRS    4
+#define SWEET_TREE_DIR_LEN     128
+#define SWEET_TREE_DIRBUF      8192
+#define SWEET_TREE_CHUNK       4096
+#define SWEET_TREE_MAX_ENTRIES 200
+#define SWEET_TREE_LINE_MAX    200
+#define SWEET_TREE_SECS        120u
+#define SWEET_TREE_MAX_BYTES   (512u * 1024u)
+
+static char sweet_tree_dirs[SWEET_TREE_MAX_DIRS][SWEET_TREE_DIR_LEN];
+static int sweet_tree_dir_count = -1;
+static char sweet_tree_ext[16] = "ips";
+static uint32_t sweet_tree_max = SWEET_TREE_MAX_BYTES;
+static uint32_t sweet_tree_time = SWEET_TREE_SECS;
+static uint32_t sweet_tree_printed;
+static uint8_t sweet_tree_dirbuf[SWEET_TREE_DIRBUF];
+static uint8_t sweet_tree_filebuf[SWEET_TREE_CHUNK];
+static char sweet_tree_line[SWEET_TREE_LINE_MAX + 1];
+
+/* True for "name.ips" (the extension is matched with its dot). */
+static int
+sweet_tree_name_matches(const char *name)
+{
+	size_t nl = strlen(name);
+	size_t el = strlen(sweet_tree_ext);
+
+	if (el == 0 || nl <= el || name[nl - el - 1] != '.') {
+		return 0;
+	}
+	return strcmp(name + nl - el, sweet_tree_ext) == 0;
+}
+
+static void
+sweet_tree_dump_file(const char *path, uint64_t size)
+{
+	vfs_context_t ctx = vfs_context_create(NULL);
+	vnode_t vp = NULLVP;
+	int err;
+	int line_len = 0;
+	uint32_t total = 0;
+
+	printf("CRASHFILE %s size=%llu\n", path, (unsigned long long)size);
+	err = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+	if (err != 0) {
+		printf("CRASHFILE %s err=%d\n", path, err);
+		vfs_context_rele(ctx);
+		return;
+	}
+	while (sweet_tree_printed < sweet_tree_max && total < sweet_tree_max) {
+		int resid = 0;
+		int n;
+
+		err = vn_rdwr(UIO_READ, vp, sweet_tree_filebuf, SWEET_TREE_CHUNK,
+		    (off_t)total, UIO_SYSSPACE, 0, vfs_context_ucred(ctx), &resid,
+		    vfs_context_proc(ctx));
+		if (err != 0) {
+			break;
+		}
+		n = SWEET_TREE_CHUNK - resid;
+		if (n <= 0) {
+			break;	/* EOF */
+		}
+		total += n;
+		for (int i = 0; i < n; i++) {
+			char c = sweet_tree_filebuf[i];
+
+			if (c == '\n') {
+				sweet_tree_line[line_len] = '\0';
+				printf("CF| %s\n", sweet_tree_line);
+				sweet_tree_printed += (uint32_t)line_len + 1;
+				line_len = 0;
+				if (sweet_tree_printed >= sweet_tree_max) {
+					break;
+				}
+				continue;
+			}
+			if (c == '\r' || c == '\0') {
+				continue;
+			}
+			if (line_len < SWEET_TREE_LINE_MAX) {
+				sweet_tree_line[line_len++] =
+				    (c >= ' ' && c < 0x7f) ? c : '.';
+			}
+		}
+	}
+	if (line_len > 0 && sweet_tree_printed < sweet_tree_max) {
+		sweet_tree_line[line_len] = '\0';
+		printf("CF| %s\n", sweet_tree_line);
+		sweet_tree_printed += (uint32_t)line_len + 1;
+	}
+	if (err != 0) {
+		printf("CF read err=%d after=%u\n", err, total);
+	}
+	printf("CRASHFILE end %s\n", path);
+	vnode_close(vp, 0, ctx);
+	vfs_context_rele(ctx);
+}
+
+static void
+sweet_tree_dump_dir(const char *dir)
+{
+	vfs_context_t ctx = vfs_context_create(NULL);
+	vnode_t dvp = NULLVP;
+	off_t dir_off = 0;
+	int eofflag = 0;
+	int err;
+	int entries = 0;
+
+	err = vnode_lookup(dir, 0, &dvp, ctx);
+	if (err != 0) {
+		printf("TREE %s err=%d\n", dir, err);
+		vfs_context_rele(ctx);
+		return;
+	}
+	while (!eofflag && entries < SWEET_TREE_MAX_ENTRIES &&
+	    sweet_tree_printed < sweet_tree_max) {
+		uio_t auio;
+		uint32_t bytes;
+		char *p;
+		char *end;
+		int numdirent = 0;
+
+		auio = uio_create(1, 0, UIO_SYSSPACE, UIO_READ);
+		if (auio == NULL) {
+			break;
+		}
+		uio_addiov(auio, (user_addr_t)(uintptr_t)sweet_tree_dirbuf,
+		    SWEET_TREE_DIRBUF);
+		auio->uio_offset = dir_off;
+		err = VNOP_READDIR(dvp, auio, 0, &eofflag, &numdirent, ctx);
+		bytes = SWEET_TREE_DIRBUF - (uint32_t)uio_resid(auio);
+		dir_off = auio->uio_offset;
+		uio_free(auio);
+		if (err != 0 || bytes == 0) {
+			break;
+		}
+		p = (char *)sweet_tree_dirbuf;
+		end = p + bytes;
+		while (p + offsetof(struct dirent, d_name) <= end &&
+		    entries < SWEET_TREE_MAX_ENTRIES &&
+		    sweet_tree_printed < sweet_tree_max) {
+			struct dirent *dep = (struct dirent *)p;
+			uint16_t reclen = dep->d_reclen;
+			uint16_t namlen = dep->d_namlen;
+			char *name = dep->d_name;
+			char path[512];
+			struct vnode_attr va;
+			uint64_t fsize = 0;
+			vnode_t fvp = NULLVP;
+			int lerr;
+
+			if (reclen < offsetof(struct dirent, d_name) + 1 ||
+			    p + reclen > end) {
+				break;
+			}
+			if (dep->d_ino != 0 && namlen != 0 &&
+			    !(namlen == 1 && name[0] == '.') &&
+			    !(namlen == 2 && name[0] == '.' && name[1] == '.')) {
+				snprintf(path, sizeof(path), "%s/%s", dir, name);
+				lerr = vnode_lookup(path, 0, &fvp, ctx);
+				if (lerr != 0) {
+					printf("TREE %s entry=%s err=%d\n", dir,
+					    name, lerr);
+				} else {
+					VATTR_INIT(&va);
+					VATTR_WANTED(&va, va_data_size);
+					if (vnode_getattr(fvp, &va, ctx) == 0) {
+						fsize = va.va_data_size;
+					}
+					printf("TREE %s entry=%s type=%u size=%llu\n",
+					    dir, name, (unsigned int)dep->d_type,
+					    (unsigned long long)fsize);
+					entries++;
+					if (sweet_tree_name_matches(name) &&
+					    vnode_isreg(fvp)) {
+						sweet_tree_dump_file(path, fsize);
+					}
+					vnode_put(fvp);
+				}
+			}
+			p += reclen;
+		}
+	}
+	vnode_put(dvp);
+	vfs_context_rele(ctx);
+}
+
+static void
+sweet_tree_parse_dirs(const char *list)
+{
+	const char *p = list;
+
+	sweet_tree_dir_count = 0;
+	while (*p != '\0' && sweet_tree_dir_count < SWEET_TREE_MAX_DIRS) {
+		const char *end = strchr(p, ',');
+		size_t n = (end != NULL) ? (size_t)(end - p) : strlen(p);
+
+		if (n > 0 && n < SWEET_TREE_DIR_LEN) {
+			memcpy(sweet_tree_dirs[sweet_tree_dir_count], p, n);
+			sweet_tree_dirs[sweet_tree_dir_count][n] = '\0';
+			sweet_tree_dir_count++;
+		}
+		if (end == NULL) {
+			break;
+		}
+		p = end + 1;
+	}
+}
+
+static void
+sweet_dumptree_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	char dirs[256];
+	char ext[16];
+	uint32_t max = 0;
+	uint32_t at = 0;
+
+	if (!PE_parse_boot_arg_str("sweetdumptree", dirs, sizeof(dirs))) {
+		return;
+	}
+	printf("TREE: thread start\n");
+	if (PE_parse_boot_arg_str("sweetdumptreeext", ext, sizeof(ext)) &&
+	    ext[0] != '\0') {
+		strlcpy(sweet_tree_ext, ext, sizeof(sweet_tree_ext));
+	}
+	if (PE_parse_boot_argn("sweetdumptreemax", &max, sizeof(max)) && max != 0) {
+		sweet_tree_max = (max < 4096u) ? 4096u : max;
+	}
+	if (PE_parse_boot_argn("sweetdumptreetime", &at, sizeof(at)) && at != 0) {
+		sweet_tree_time = at;
+	}
+	sweet_tree_parse_dirs(dirs);
+	if (sweet_tree_dir_count <= 0) {
+		printf("TREE: no directories parsed\n");
+		return;
+	}
+	printf("TREE: %d dirs, ext=%s, wait=%u s\n", sweet_tree_dir_count,
+	    sweet_tree_ext, sweet_tree_time);
+	sweet_dump_sleep_until((uint64_t)sweet_tree_time);
+	printf("TREE: dumping at uptime %llu s\n",
+	    (unsigned long long)sweet_dump_uptime_sec());
+	for (int i = 0; i < sweet_tree_dir_count && sweet_tree_printed < sweet_tree_max; i++) {
+		sweet_tree_dump_dir(sweet_tree_dirs[i]);
+	}
+	printf("TREE: end printed=%u bytes\n", sweet_tree_printed);
+}
+
+void
+sweet_dumptree_start(void)
+{
+	thread_t thread;
+
+	if (kernel_thread_start(sweet_dumptree_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
