+}
+
+
+/*
+ * 0137: platform halt/restart hook.  PE_halt_restart is the global function
+ * pointer IOPlatformExpert::haltRestart() calls; on this port nothing assigns
+ * it, so a clean reboot waits for the fake shutdown handshake, times out
+ * after 30 s and panics ("Halt/Restart Timed Out").  Our hook turns both the
+ * clean path and the panic path into a watchdog reset.
+ */
+extern int (*PE_halt_restart)(unsigned int type);
+
+/* Pre-shutdown bite: 8 s at 32768 Hz, overridable with sweetrebootticks. */
+#define SWEET_WDT_REBOOT_TICKS 0x40000u
+
+static int
+sweet_pe_halt_restart(unsigned int type)
+{
+	printf("SWEET HALT: type=%u -> WDT reset\n", type);
+	sweet_reset_fallback();
+	for (;;) {
+		delay(1000000);
+	}
+	return 0;	/* not reached */
+}
+
+/* Arm a short WDT bite before reboot_kernel(), so a hung clean shutdown (the
+ * 30 s Halt/Restart handshake timeout) still ends in a reset. */
+static void
+sweet_wdt_arm_pre_shutdown(void)
+{
+	uint32_t ticks = SWEET_WDT_REBOOT_TICKS;
+
+	if (!PE_parse_boot_argn("sweetrebootticks", &ticks, sizeof(ticks)) ||
+	    ticks == 0) {
+		ticks = SWEET_WDT_REBOOT_TICKS;
+	}
+	printf("SWEET WDT: armed bite in %u ticks (pre-shutdown)\n", ticks);
+	sweet_wdt_arm(ticks);
 }
 
 
