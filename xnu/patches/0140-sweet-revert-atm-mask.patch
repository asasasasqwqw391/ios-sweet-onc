-	 * os_state_add_handler() returns 0 when userspace sees that bit, which
-	 * makes BaseBoard return a nil block and PaperBoardUI crash SpringBoard.
-	 * sweet_oslog_off=1 sets the internal bit without the generic
-	 * atm_diagnostic_config boot arg.  atm_get_diagnostic_config() masks the
-	 * bit for userspace; os/log.c reads the raw accessor for the kernel.
-	 */
-	{
-		uint32_t oslog_off = 0;
-
-		if (PE_parse_boot_argn("sweet_oslog_off", &oslog_off, sizeof(oslog_off)) &&
-		    oslog_off != 0) {
-			atm_diagnostic_config |= ATM_TRACE_DISABLE;
-		}
-	}
-	if (atm_diagnostic_config & ATM_TRACE_DISABLE) {
-		kprintf("SWEET ATM: kernel oslog disabled, userspace bit masked\n");
-	}
-
 	kprintf("ATM subsystem is initialized\n");
 }
 
@@ -122,19 +101,5 @@
 uint32_t
