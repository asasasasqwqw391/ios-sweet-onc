-	 * os_state_add_handler() then returns 0, which breaks BaseBoard /
-	 * PaperBoardUI (SpringBoard SIGABRT).  All other bits pass through.
-	 */
-	return atm_diagnostic_config & ~((uint32_t)ATM_TRACE_DISABLE);
-}
