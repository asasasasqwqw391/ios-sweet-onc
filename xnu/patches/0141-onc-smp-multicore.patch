--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -10,6 +10,7 @@
 #include <machine/atomic.h>
 #include <machine/machine_routines.h>
 #include <pexpert/device_tree.h>
+#include <pexpert/pexpert.h>
 #include <pexpert/arm64/board_config.h>
 
 #if defined(SWEET) && !HAS_GIC_V3
@@ -307,6 +308,38 @@
 	__builtin_arm_dsb(DSB_ISHST);
 	gicd_write32(GICD_SGIR, GICD_SGIR_SELF_ONLY |
 	    GICD_SGIR_SGI(SWEET_IPI_SGI));
+	__builtin_arm_isb(ISB_SY);
+}
+
+/*
+ * onc: deliver the IPI SGI to one specific PE (TargetListFilter 0b00,
+ * CPUTargetList).  signalCPU() uses this for cross-CPU wakeups once cpus>1;
+ * the initCPU handshake keeps the safe 0b10 self-only path above.
+ *
+ * The GIC-400 CPU-interface number is not derivable from MPIDR here, so it is
+ * assumed to be the logical CPU number; an optional boot arg
+ * `sweetgiccpuoff=<n>` is added to it (default 0) so a wrong assumption can be
+ * fixed without rebuilding.
+ */
+void
+pe_gic_send_ipi_cpu(uint32_t cpu)
+{
+	static int gic_cpu_off = -1;
+	uint32_t iface;
+
+	if (gic_cpu_off < 0) {
+		uint32_t off = 0;
+
+		gic_cpu_off = PE_parse_boot_argn("sweetgiccpuoff", &off,
+		    sizeof(off)) ? (int)off : 0;
+	}
+	iface = cpu + (uint32_t)gic_cpu_off;
+	if (iface >= 8) {
+		return;
+	}
+	__builtin_arm_dsb(DSB_ISHST);
+	gicd_write32(GICD_SGIR, GICD_SGIR_SGI(SWEET_IPI_SGI) |
+	    GICD_SGIR_TARGET_LIST(1U << iface));
 	__builtin_arm_isb(ISB_SY);
 }
 
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -78,6 +78,7 @@
 #define GICD_SGIR_SGI(intid)      ((uint32_t)((intid) & 0xf))
 #define GICD_SGIR_ALL_BUT_SELF    (1U << 24)   /* TargetListFilter = 0b01 */
 #define GICD_SGIR_SELF_ONLY       (2U << 24)   /* TargetListFilter = 0b10 */
+#define GICD_SGIR_TARGET_LIST(b)  ((uint32_t)((b) & 0xffu) << 16) /* 0b00 */
 
 #define GIC_INTID_SPURIOUS_MIN    1020
 
