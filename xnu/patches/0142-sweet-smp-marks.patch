@@ -36,6 +36,44 @@
 #include <arm64/tunables/tunables.s>
 #include <arm64/exception_asm.h>
 
+/*
+ * 0142: secondary-CPU progress marks, usable with the MMU OFF.
+ *
+ * The progress variables live in kernel BSS, addressable only through the KVA
+ * once the MMU is on.  The early entry path runs with the MMU off, so derive
+ * the physical address from the PC: the image is linked V=P, hence
+ *     PA(sym) = PC_pa + (sym_VA - entry_VA)
+ * (no absolute constants, works for every link address).
+ * Clobbers x10, x11, x12; \index is read before x10-x12 are touched.
+ */
+.macro SWEET_MARK mark, index
+	adr	x10, .
+	adrp	x11, EXT(sweet_secondary_marks)@page
+	add	x11, x11, EXT(sweet_secondary_marks)@pageoff
+	adrp	x12, EXT(sweet_secondary_entry)@page
+	add	x12, x12, EXT(sweet_secondary_entry)@pageoff
+	sub	x11, x11, x12
+	add	x10, x10, x11
+	MOV64	x11, \mark
+	str	x11, [x10, \index, lsl #3]
+	dsb	sy
+.endm
+
+/* Last stage reached by any secondary (single slot, MMU-off safe). */
+.macro SWEET_STAGE stage
+	adr	x10, .
+	adrp	x11, EXT(sweet_smp_stage)@page
+	add	x11, x11, EXT(sweet_smp_stage)@pageoff
+	adrp	x12, EXT(sweet_secondary_entry)@page
+	add	x12, x12, EXT(sweet_secondary_entry)@pageoff
+	sub	x11, x11, x12
+	add	x10, x10, x11
+	MOV64	x11, \stage
+	str	x11, [x10]
+	dsb	sy
+.endm
+
+
