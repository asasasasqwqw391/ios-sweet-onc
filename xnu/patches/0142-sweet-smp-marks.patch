 extern "C" void sweet_secondary_entry(void);
 extern "C" boolean_t sweet_cpu_signal_is_enabled(unsigned int cpu);
+
+/*
+ * 0142: secondary-CPU progress marks (C linkage so start.s can write them).
+ *
+ * The entry stub and start.s run with the MMU off, so start.s computes the
+ * physical address of these symbols from its own PC (the image is linked V=P).
+ * Index = logical CPU id (the PSCI context id / MPIDR-derived in reset_vector).
+ */
+extern "C" {
+volatile uint64_t sweet_secondary_marks[8];
+volatile uint64_t sweet_smp_stage;
+volatile uint64_t sweet_smp_vector_hit;
+}
+
+static inline void
+sweet_smp_mark(uint32_t cpu, uint64_t mark)
+{
+	if (cpu < 8) {
+		__atomic_store_n(&sweet_secondary_marks[cpu], mark,
+		    __ATOMIC_RELEASE);
+	}
+}
+
+static inline uint64_t
+sweet_smp_get(uint32_t cpu)
+{
+	if (cpu < 8) {
+		return __atomic_load_n(&sweet_secondary_marks[cpu],
+		    __ATOMIC_ACQUIRE);
+	}
+	return 0;
+}
 
