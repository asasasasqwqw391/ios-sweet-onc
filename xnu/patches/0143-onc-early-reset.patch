+#if defined(ONC_SWEET_4K)
+/*
+ * 0143: early reset safety net.
+ *
+ * SweetCPU::startAll() (SMP bring-up) runs before onc_emmc_init(), so the
+ * 0137 hook used to be installed too late: a panic in the SMP path left the
+ * phone spinning on the panic screen.  arm_init() calls this right after
+ * PE_init_cpu(), i.e. after arm_vm_init() (ml_io_map works) and after
+ * PE_init_printf() (printf works), but before machine_startup()/IOKit.
+ *
+ * The hook turns panics into a reset; a hard hang is caught by the safety
+ * watchdog.  A successful boot reaches onc_emmc_init(), which disarms the
+ * safety WDT (from there on the hook covers later panics).
+ */
+#define SWEET_EARLY_WDT_SECS 120u
+
+void
+sweet_early_reset_install(void)
+{
+	uint32_t on = 1;
+	uint32_t secs = 0;
+	uint32_t ticks;
+
+	if (PE_parse_boot_argn("sweetearlyreset", &on, sizeof(on)) && on == 0) {
+		printf("SWEET RESET: early hook disabled (sweetearlyreset=0)\n");
+		return;
+	}
+	if (PE_parse_boot_argn("sweetearlywdts", &secs, sizeof(secs)) &&
+	    secs != 0) {
+		if (secs > 600) {
+			secs = 600;
+		}
+	} else {
+		secs = SWEET_EARLY_WDT_SECS;
+	}
+	ticks = secs * 32768u;
+	printf("SWEET RESET: early hook install, safety WDT %u s\n", secs);
+	if (sweet_wdt_get() == 0) {
+		printf("SWEET RESET: WDT not mappable yet, hook only\n");
+	}
+	PE_halt_restart = sweet_pe_halt_restart;
+	if (sweet_wdt_get() != 0) {
+		sweet_wdt_arm(ticks);
+	}
+}
+
+/* Disarm the safety WDT once a live boot passed the early init/SMP phase. */
+static void
+sweet_wdt_disarm(void)
+{
+	vm_offset_t wdt = sweet_wdt_get();
+
+	if (wdt == 0) {
+		return;
+	}
+	oe_wr(wdt, SWEET_WDT_EN, 0);
+	__asm__ volatile("dsb sy" ::: "memory");
+	oe_wr(wdt, SWEET_WDT_RST, 1);
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("SWEET WDT: safety WDT disarmed (STS=0x%x)\n",
+	    oe_rd(wdt, SWEET_WDT_STS));
+}
+#endif /* ONC_SWEET_4K */
+
 
