 #define SWEET_EARLY_WDT_SECS 120u
 
+/*
+ * 0144: IMEM restart reason.  An early panic reset should land in the
+ * bootloader (fastboot) instead of the recovery/normal chain, so the host
+ * loop can start the next cycle from fastboot without the shim having to
+ * clear the Android BCB on a failing boot.  onc: IMEM restart_reason is at
+ * physical 0x0860065c, value 0x77665500 = "bootloader" (same constants as
+ * xnuios/shim-onc/shim.c).  `sweetearlyfb=0` disables it.
+ */
+#define SWEET_IMEM_PHYS                0x08600000u
+#define SWEET_IMEM_SIZE                0x1000u
+#define SWEET_IMEM_RESTART_REASON      0x65cu
+#define SWEET_RESTART_REASON_BOOTLOADER 0x77665500u
+
+static vm_offset_t sweet_imem_base;
+static int sweet_early_fb_set;
+
+static int
+sweet_restart_reason(uint32_t value)
+{
+	if (sweet_imem_base == 0) {
+		sweet_imem_base = ml_io_map(SWEET_IMEM_PHYS, SWEET_IMEM_SIZE);
+	}
+	if (sweet_imem_base == 0) {
+		printf("SWEET RESET: IMEM 0x%x not mappable\n", SWEET_IMEM_PHYS);
+		return -1;
+	}
+	oe_wr(sweet_imem_base, SWEET_IMEM_RESTART_REASON, value);
+	__asm__ volatile("dsb sy" ::: "memory");
+	return 0;
+}
