+/*
+ * 0144: secondary-only progress marks.
+ *
+ * This function runs ONLY on PSCI CPU_ON (secondaries); the boot CPU takes
+ * _start -> start_first_cpu and never executes anything here, so the
+ * boot-CPU path is byte-identical to the CI base again (0142's marks in
+ * reset_vector/start_cpu/common_start are reverted by this patch).
+ *
+ * A PSCI CPU_ON entry has no stack (SMCCC only defines x0 = context_id), so
+ * nothing is pushed via SP.  Only x2/x3/x16/x17 are used; all of them are
+ * dead at this entry (caller-saved / intra-procedure scratch, and this is the
+ * first code to run).  x0 (context id) is saved in x2 and restored at the end
+ * of every mark; x0/x1 and x18-x30 are never touched.
+ *
+ * MMU is off: PA(sym) = PC_pa + (sym_VA - entry_VA) (image linked V=P).
+ */
+.macro SWEET_ENTRY_MARK mark, stage
+	mov	x2, x0
+	cmp	x2, #8
+	b.hs	9f
+	/* per-cpu mark: sweet_secondary_marks[context] = mark */
+	adr	x3, .
+	adrp	x16, EXT(sweet_secondary_marks)@page
+	add	x16, x16, EXT(sweet_secondary_marks)@pageoff
+	adrp	x17, EXT(sweet_secondary_entry)@page
+	add	x17, x17, EXT(sweet_secondary_entry)@pageoff
+	sub	x17, x16, x17
+	add	x16, x3, x17
+	MOV64	x17, \mark
+	str	x17, [x16, x2, lsl #3]
+	dsb	sy
+	/* single global stage slot: sweet_smp_stage = stage */
+	adr	x3, .
+	adrp	x16, EXT(sweet_smp_stage)@page
+	add	x16, x16, EXT(sweet_smp_stage)@pageoff
+	adrp	x17, EXT(sweet_secondary_entry)@page
+	add	x17, x17, EXT(sweet_secondary_entry)@pageoff
+	sub	x17, x16, x17
+	add	x16, x3, x17
+	MOV64	x17, \stage
+	str	x17, [x16]
+	dsb	sy
+9:
+	mov	x0, x2
+.endm
 
