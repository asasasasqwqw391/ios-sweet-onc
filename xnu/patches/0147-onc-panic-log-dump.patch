+/*
+ * 0147: write the console ring to the userdata log tail, in exactly the layout
+ * the 0132 flusher uses (tools/sweet-log.py decodes it unchanged).  Called
+ * from the 0144 halt hook before the reset.  Bounded and best-effort: the
+ * header plus the newest `sweetpanicdumpkb` KiB (default 32) of the 4 MiB ring
+ * are written, so the panic lines at the tail are always included; at the
+ * 400 kHz legacy link this is roughly 0.8 s.  Never panics/hangs; any failure
+ * prints a reason and returns so the reset still happens.
+ */
+void
+sweet_panic_log_dump(void)
+{
+	static uint8_t hdr[SWEET_EMMC_LOG_BLKSIZE];
+	static uint8_t blk[SWEET_EMMC_LOG_BLKSIZE];
+	static uint8_t oldhdr[OE_BLOCK_SIZE];
+	struct sweet_emmc_log_header h;
+	uint64_t base;
+	uint64_t total;
+	uint64_t start_abs;
+	uint64_t seq = 1;
+	uint32_t on = 1;
+	uint32_t kb = 32;
+	uint32_t nblocks;
+	uint32_t i;
+	uint32_t j;
+	int rc;
+
+	if (PE_parse_boot_argn("sweetpanicdump", &on, sizeof(on)) && on == 0) {
+		printf("SWEET PANICDUMP: disabled (sweetpanicdump=0)\n");
+		return;
+	}
+	rc = sweet_early_card_init();
+	if (rc != 0) {
+		printf("SWEET PANICDUMP: eMMC init failed rc=%d\n", rc);
+		return;
+	}
+	/* Always (re)scan so oe.first_lba/nblocks point at userdata, whatever
+	 * partition the normal root selection used.  A few single-block reads. */
+	rc = oe_gpt_scan("userdata");
+	if (rc != 0) {
+		printf("SWEET PANICDUMP: GPT scan failed rc=%d\n", rc);
+		return;
+	}
+	if (oe.nblocks <= 2 * SWEET_EMMC_LOG_LBAS) {
+		printf("SWEET PANICDUMP: userdata too small for the log tail\n");
+		return;
+	}
+	base = oe.first_lba + oe.nblocks - SWEET_EMMC_LOG_LBAS;
+	total = sweet_log_position();
+	if (total == 0) {
+		printf("SWEET PANICDUMP: console ring is empty\n");
+		return;
+	}
+
+	if (PE_parse_boot_argn("sweetpanicdumpkb", &kb, sizeof(kb)) &&
+	    kb >= 4) {
+		if (kb > SWEET_EMMC_LOG_RING / 1024) {
+			kb = SWEET_EMMC_LOG_RING / 1024;
+		}
+	} else {
+		kb = 32;
+	}
+	nblocks = kb / (SWEET_EMMC_LOG_BLKSIZE / 1024);
+	if (nblocks == 0) {
+		nblocks = 1;
+	}
+	if (nblocks > SWEET_EMMC_LOG_RING / SWEET_EMMC_LOG_BLKSIZE) {
+		nblocks = SWEET_EMMC_LOG_RING / SWEET_EMMC_LOG_BLKSIZE;
+	}
+	start_abs = (total > (uint64_t)nblocks * SWEET_EMMC_LOG_BLKSIZE) ?
+	    total - (uint64_t)nblocks * SWEET_EMMC_LOG_BLKSIZE : 0;
+	start_abs &= ~((uint64_t)SWEET_EMMC_LOG_BLKSIZE - 1);
+	{
+		uint64_t nb = (total - start_abs + SWEET_EMMC_LOG_BLKSIZE - 1) /
+		    SWEET_EMMC_LOG_BLKSIZE;
+
+		if (nb > nblocks) {
+			nb = nblocks;
+		}
+		nblocks = (uint32_t)nb;
+	}
+	if (nblocks == 0) {
+		printf("SWEET PANICDUMP: nothing to write\n");
+		return;
+	}
+
+	/* Read the previous header (if any) so seq keeps incrementing. */
+	memset(oldhdr, 0, sizeof(oldhdr));
+	if (oe_read_lba(base, oldhdr) == 0 &&
+	    memcmp(oldhdr, "SWEETLOG", 8) == 0) {
+		struct sweet_emmc_log_header old;
+
+		memcpy(&old, oldhdr, sizeof(old));
+		seq = old.seq + 1;
+		if (seq == 0) {
+			seq = 1;
+		}
+	}
+
+	memset(hdr, 0, sizeof(hdr));
+	memset(&h, 0, sizeof(h));
+	memcpy(h.magic, "SWEETLOG", 8);
+	h.version = 1;
+	h.size = SWEET_EMMC_LOG_RING;
+	h.total = total;
+	h.seq = seq;
+	memcpy(hdr, &h, sizeof(h));
+	for (i = 0; i < SWEET_EMMC_LOG_BLKSIZE / OE_BLOCK_SIZE; i++) {
+		rc = oe_write_lba(base + i, hdr + (uint64_t)i * OE_BLOCK_SIZE);
+		if (rc != 0) {
+			printf("SWEET PANICDUMP: header write failed rc=%d\n", rc);
+			return;
+		}
+	}
+
+	for (i = 0; i < nblocks; i++) {
+		uint64_t abs = start_abs + (uint64_t)i * SWEET_EMMC_LOG_BLKSIZE;
+		uint64_t pos = abs;
+		uint32_t got;
+		uint32_t ring_blk;
+		uint64_t out_lba;
+
+		memset(blk, 0, sizeof(blk));
+		got = sweet_log_copy(&pos, (char *)blk,
+		    SWEET_EMMC_LOG_BLKSIZE);
+		if (got == 0) {
+			continue;
+		}
+		ring_blk = (uint32_t)((abs / SWEET_EMMC_LOG_BLKSIZE) %
+		    (SWEET_EMMC_LOG_RING / SWEET_EMMC_LOG_BLKSIZE));
+		out_lba = base + (uint64_t)(1 + ring_blk) *
+		    (SWEET_EMMC_LOG_BLKSIZE / OE_BLOCK_SIZE);
+		for (j = 0; j < SWEET_EMMC_LOG_BLKSIZE / OE_BLOCK_SIZE; j++) {
+			rc = oe_write_lba(out_lba + j,
+			    blk + (uint64_t)j * OE_BLOCK_SIZE);
+			if (rc != 0) {
+				printf("SWEET PANICDUMP: ring write failed "
+				    "block 0x%llx rc=%d\n", out_lba + j, rc);
+				return;
+			}
+		}
+	}
+	printf("SWEET PANICDUMP: wrote %u bytes (header + %u ring blocks) "
+	    "-> block 0x%llx seq=%llu total=%llu\n",
+	    (SWEET_EMMC_LOG_BLKSIZE +
+	    nblocks * SWEET_EMMC_LOG_BLKSIZE), nblocks, base,
+	    (unsigned long long)seq, (unsigned long long)total);
 }
 #endif /* ONC_SWEET_4K */
 
