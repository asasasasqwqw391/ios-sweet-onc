+/*
+ * 0149: CMD13 (SEND_STATUS) on the selected card.  Returns the R1 status
+ * word, or 0xFFFFFFFF when the command itself failed (printed).
+ */
+static uint32_t
+sweet_early_card_status(void)
+{
+	uint32_t resp[4] = { 0, 0, 0, 0 };
+	uint32_t ist = 0;
+	int rc;
+
+	rc = oe_issue(OE_CMD_IDX(13) | OE_RSP_48 | OE_CC_CRC | OE_CC_IDX,
+	    oe.rca << 16, resp, &ist);
+	if (rc != 0) {
+		printf("SWEET EARLYMISC: CMD13 (status) failed rc=%d int=0x%08x\n",
+		    rc, ist);
+		return 0xFFFFFFFFu;
+	}
+	return resp[0];
+}
