+/*
+ * 0150: PSCI_AFFINITY_INFO (64-bit function id 0x84000004) for the SMP probe.
+ * level 0 is the lowest affinity level.  Returns 0 = ON/running, 1 = OFF,
+ * 2 = ON_PENDING, negative = PSCI error (e.g. -1 NOT_SUPPORTED,
+ * -3 INVALID_PARAMETERS).
+ */
+static int32_t
+sweet_psci_affinity_info(uint64_t target, uint32_t level)
+{
+	register uint64_t x0 __asm__("x0") = 0x84000004ULL;
+	register uint64_t x1 __asm__("x1") = target;
+	register uint64_t x2 __asm__("x2") = level;
+	register uint64_t x3 __asm__("x3") = 0;
+	__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+	    "x14", "x15", "x16", "x17", "cc", "memory");
+	return (int32_t)x0;
+}
+
+/*
+ * 0150: dc civac (clean+invalidate to PoC) over a VA range, then dsb/isb so
+ * the next load comes from memory.  Used to (a) push the zeroed mark words to
+ * DRAM and drop the boot CPU's dirty lines before CPU_ON, and (b) invalidate
+ * the boot CPU's view when reading the marks back on timeout.
+ */
+static void
+sweet_dc_civac_region(vm_offset_t va, size_t size)
+{
+	vm_offset_t start = va & ~(vm_offset_t)0x3F;
+	vm_offset_t end = (va + size + 0x3F) & ~(vm_offset_t)0x3F;
+	vm_offset_t a;
+
+	for (a = start; a < end; a += 0x40) {
+		__asm__ volatile("dc civac, %0" :: "r"(a) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	__asm__ volatile("isb" ::: "memory");
+}
+
+static void
+sweet_smp_cleaninval_marks(void)
+{
+	sweet_dc_civac_region((vm_offset_t)&sweet_secondary_marks[0],
+	    sizeof(sweet_secondary_marks));
+	sweet_dc_civac_region((vm_offset_t)&sweet_smp_stage,
+	    sizeof(sweet_smp_stage));
+	sweet_dc_civac_region((vm_offset_t)&sweet_smp_vector_hit,
+	    sizeof(sweet_smp_vector_hit));
+}
+
+/* 0150: uncached alias of the physical page holding sweet_secondary_marks[]. */
+static volatile uint64_t *
+sweet_smp_marks_uncached(void)
+{
+	static volatile uint64_t *alias = NULL;
+
+	if (alias == NULL) {
+		vm_offset_t va = (vm_offset_t)&sweet_secondary_marks[0];
+		vm_offset_t off = va & 0xFFF;
+		vm_offset_t page_pa = ml_static_vtop(va) & ~(vm_offset_t)0xFFF;
+		vm_offset_t map = ml_io_map(page_pa, 0x2000);
+
+		if (map != 0) {
+			alias = (volatile uint64_t *)(map + off);
+		} else {
+			IOLog("SWEET CPU: uncached mark alias unavailable\n");
+		}
+	}
+	return alias;
+}
+
+static uint64_t
+sweet_smp_mark_uncached_read(uint32_t cpu)
+{
+	volatile uint64_t *marks = sweet_smp_marks_uncached();
+
+	if (marks == NULL || cpu >= 8) {
+		return 0;
+	}
+	return marks[cpu];
+}
+
+/*
+ * 0150: `sweetmtest=1` - after CPU_ON, poll the uncached mark for up to 2 s
+ * and print the first nonzero value with elapsed time.  Cheap way to see
+ * whether the secondary ever runs, without waiting for the 5 s timeout.
+ */
+static void
+sweet_smp_mark_test(uint32_t cpu)
+{
+	uint64_t start = mach_absolute_time();
+	uint64_t deadline;
+	uint64_t value;
+
+	nanoseconds_to_deadline(2 * NSEC_PER_SEC, &deadline);
+	while (mach_absolute_time() < deadline) {
+		value = sweet_smp_mark_uncached_read(cpu);
+		if (value != 0) {
+			uint64_t ns = 0;
+
+			absolutetime_to_nanoseconds(mach_absolute_time() -
+			    start, &ns);
+			IOLog("SWEET CPU: mtest cpu=%u mark_uncached=0x%llx "
+			    "after %llu ms\n", cpu, (unsigned long long)value,
+			    (unsigned long long)(ns / 1000000ULL));
+			return;
+		}
+		onc_spin_us(1000);
+	}
+	IOLog("SWEET CPU: mtest cpu=%u no mark within 2 s "
+	    "(uncached=0x%llx)\n", cpu,
+	    (unsigned long long)sweet_smp_mark_uncached_read(cpu));
 }
 
