+/*
+ * 0151: read-only accessor for the first ptov_table entries.  The SweetCPU SMP
+ * bring-up log uses it to show why ml_static_vtop() returned a PA outside the
+ * kernel physical window for a kernel text VA (a stale/early ptov_table hit
+ * instead of the "illegal VA" panic path).
+ */
+void
+sweet_get_ptov_entries(uint64_t *va, uint64_t *pa, uint64_t *len, uint32_t max,
+    uint32_t *count)
+{
+	uint32_t n = 0;
+
+	for (size_t i = 0; (i < PTOV_TABLE_SIZE) && (i < (size_t)max) &&
+	    (ptov_table[i].len != 0); i++) {
+		if (va != NULL) {
+			va[n] = ptov_table[i].va;
+		}
+		if (pa != NULL) {
+			pa[n] = ptov_table[i].pa;
+		}
+		if (len != NULL) {
+			len[n] = ptov_table[i].len;
+		}
+		n++;
+	}
+	if (count != NULL) {
+		*count = n;
+	}
 }
 
