+/* 0152: raw cpu_signal / CpuData VA for the SMP timeout diagnostics. */
+uint32_t
+sweet_cpu_get_signal_raw(unsigned int cpu)
+{
+	if (cpu >= MAX_CPUS) {
+		return 0;
+	}
+	cpu_data_t *cdp = CpuDataEntries[cpu].cpu_data_vaddr;
+	return cdp != NULL ? os_atomic_load(&cdp->cpu_signal, acquire) : 0;
+}
+
+uint64_t
+sweet_cpu_data_va(unsigned int cpu)
+{
+	if (cpu >= MAX_CPUS) {
+		return 0;
+	}
+	return (uint64_t)(uintptr_t)CpuDataEntries[cpu].cpu_data_vaddr;
+}
