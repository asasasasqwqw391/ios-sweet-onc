+
+/*
+ * 0152: per-CPU GICv2 bank bring-up.
+ *
+ * On a GIC-400 the SGI/PPI distributor registers (IGROUPR0, IPRIORITYR0,
+ * ICFGR1, ISENABLER0) and the whole CPU interface (GICC_*) are banked per PE:
+ * every PE must program its own bank from its own context.  pe_init_fiq()
+ * only runs on the boot CPU, so without this the self-IPI queued by
+ * SweetCPU::initCPU() on a secondary stays pending and SIGPdisabled is never
+ * cleared (the SMP handshake times out with sig=0).
+ */
+void
+pe_gic_cpu_enable(void)
+{
+	uint32_t gicc_ctlr;
+
+	if (!gicd_base || !gicc_base) {
+		return;
+	}
+	gicd_write32(GICD_IGROUPR0, 0xFFFFFFFF);
+	for (unsigned int i = 0; i < 32; i += 4) {
+		gicd_write32(GICD_IPRIORITYR0 + i, 0xA0A0A0A0);
+	}
+	gicd_write32(GICD_ICFGR1, 0);
+	gicd_write32(GICD_ISENABLER0,
+	    (1U << sweet_vtimer_intid) | (1U << SWEET_IPI_SGI));
+	gicc_write32(GICC_PMR, 0xFF);
+	gicc_write32(GICC_BPR, 0);
+	gicc_ctlr = gicc_read32(GICC_CTLR);
+	gicc_ctlr |= GICC_CTLR_ENABLEGRP1 | GICC_CTLR_ENABLEGRP1A;
+	gicc_write32(GICC_CTLR, gicc_ctlr);
+	__builtin_arm_dsb(DSB_SY);
+	__builtin_arm_isb(ISB_SY);
+}
+
+/* 0152: read this PE's GICv2 bank back (returns 0 if the GIC is unmapped). */
+uint32_t
+pe_gic_cpu_state(uint32_t *ctlr, uint32_t *pmr, uint32_t *isen)
+{
+	if (!gicd_base || !gicc_base) {
+		return 0;
+	}
+	if (ctlr != NULL) {
+		*ctlr = gicc_read32(GICC_CTLR);
+	}
+	if (pmr != NULL) {
+		*pmr = gicc_read32(GICC_PMR);
+	}
+	if (isen != NULL) {
+		*isen = gicd_read32(GICD_ISENABLER0);
+	}
+	return 1;
 }
 
