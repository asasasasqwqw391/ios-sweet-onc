+/*
+ * 0154: eMMC-init gate for the secondary CPUs, as a BLOCKING wait.
+ *
+ * The first attempt (0145) busy-spun with onc_spin_us() in this kernel thread
+ * while only the boot CPU was online.  That starved the BSD-init thread that
+ * eventually calls onc_emmc_init(), so the flag was never set and the safety
+ * WDT reset the SoC after ~120 s.  Sleep instead: this thread blocks on a
+ * wait channel and the scheduler runs the bootstrap thread that brings up
+ * IOKit/BSD and the eMMC driver.
+ *
+ * Why gate at all: a secondary-CPU panic before onc_emmc_init() happens
+ * *before* the Android BCB is cleared and before the SWEETLOG flusher starts,
+ * so the reset lands back in the recovery partition and the panic text only
+ * flashes on the panel.  After the gate the BCB is already clear, the reset
+ * goes to boot=TWRP and the flusher writes the ring (with the panic text) to
+ * the userdata tail.
+ */
+extern "C" {
+volatile int sweet_emmc_ready;
+}
+
+/* 0154: the gate must only be evaluated once per boot. */
+static int sweet_emmc_gate_done;
+
+#define SWEET_EMMC_GATE_CHAN ((event_t)(uintptr_t)&sweet_emmc_ready)
+
+/* Wait (blocking) for the eMMC init, up to `secs` seconds.  Returns 1 if the
+ * eMMC came up, 0 on timeout.  Never spins, never holds a lock. */
+static int
+sweet_wait_emmc_ready(uint32_t secs)
+{
+	uint32_t waited_ms = 0;
+
+	while (__atomic_load_n(&sweet_emmc_ready, __ATOMIC_ACQUIRE) == 0) {
+		if (secs == 0 || waited_ms >= secs * 1000U) {
+			return 0;
+		}
+		/*
+		 * assert_wait_timeout() gives us a real sleep with a timeout, so a
+		 * missing wakeup (or a flusher that never starts) still returns.
+		 * 10 ms per iteration keeps the console quiet and the loop short.
+		 * scale_factor is ns per unit: 1000 * NSEC_PER_USEC == 1 ms.
+		 */
+		assert_wait_timeout((event_t)SWEET_EMMC_GATE_CHAN, THREAD_UNINT,
+		    10, 1000 * NSEC_PER_USEC);
+		thread_block(THREAD_CONTINUE_NULL);
+		waited_ms += 10;
+	}
+	return 1;
+}
 
