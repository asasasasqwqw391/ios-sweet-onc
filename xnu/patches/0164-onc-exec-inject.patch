0164-onc-exec-inject -- port hakios kern.exec_inject (kernel-level dylib injection).

launchd refuses DYLD_* from job plists (real reason cahook dylib never loaded).
sysctl kern.exec_inject holds "LIBRARY NAME NAME[;LIBRARY2 NAME2]";
exec_extract_strings() injects DYLD_INSERT_LIBRARIES=<lib> into matching
programs via exec_add_user_string(), bypassing launchd.  Ported from
oosexgang/hakios-xnu-kernel kernel/patches/0006-bsd-process.patch.
Default: empty sysctl = no change.  Only bsd/kern/kern_exec.c.

--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -5568,10 +5568,72 @@
  * Note:	The argument and environment vectors are user space pointers
  *		to arrays of user space pointers.
  */
+/*
+ * 0164: kern.exec_inject -- "LIBRARY NAME NAME [;LIBRARY2 NAME2]".
+ * Programs whose file name matches a NAME get DYLD_INSERT_LIBRARIES=LIBRARY
+ * added to their environment by the kernel (launchd refuses to pass DYLD_*
+ * variables from a job plist).  Set by our init/kext early in boot.
+ */
+static char exec_inject_conf[4096];
+SYSCTL_STRING(_kern, OID_AUTO, exec_inject, CTLFLAG_RW | CTLFLAG_LOCKED,
+    exec_inject_conf, sizeof(exec_inject_conf),
+    "LIBRARY NAME... [;LIBRARY NAME...]: programs started with library inserted");
+
+static bool
+exec_inject_env(struct image_params *imgp, char *env, size_t size)
+{
+	const char *name, *p = exec_inject_conf;
+	size_t namelen, used;
+	bool any = false;
+
+	if (*p == 0 || imgp->ip_ndp == NULL) {
+		return false;
+	}
+	name = imgp->ip_ndp->ni_cnd.cn_nameptr;
+	namelen = imgp->ip_ndp->ni_cnd.cn_namelen;
+	used = strlcpy(env, "DYLD_INSERT_LIBRARIES=", size);
+	while (*p != 0) {
+		const char *library;
+		size_t liblen;
+		bool matched = false;
+
+		while (*p == ' ' || *p == ';') {
+			p++;
+		}
+		library = p;
+		while (*p != 0 && *p != ' ' && *p != ';') {
+			p++;
+		}
+		liblen = (size_t)(p - library);
+		while (*p == ' ') {
+			const char *word = ++p;
+
+			while (*p != 0 && *p != ' ' && *p != ';') {
+				p++;
+			}
+			if (!matched && (size_t)(p - word) == namelen && namelen != 0 && liblen != 0 &&
+			    strncmp(word, name, namelen) == 0) {
+				matched = true;
+			}
+		}
+		if (matched && liblen != 0 && used + 1 + liblen < size) {
+			if (any) {
+				env[used++] = ':';
+			}
+			memcpy(env + used, library, liblen);
+			used += liblen;
+			env[used] = 0;
+			any = true;
+		}
+	}
+	return any;
+}
+
 __attribute__((noinline))
 static int
 exec_extract_strings(struct image_params *imgp)
 {
+	char inject_env[512];
 	int error = 0;
 	int     ptr_size = (imgp->ip_flags & IMGPF_WAS_64BIT_ADDR) ? 8 : 4;
 	int new_ptr_size = (imgp->ip_flags & IMGPF_IS_64BIT_ADDR) ? 8 : 4;
@@ -5739,6 +5801,18 @@
 		}
 		imgp->ip_argspace -= new_ptr_size; /* to hold envv[] entry */
 		imgp->ip_envc++;
+	}
+
+	/* 0164: kernel-level DYLD_INSERT_LIBRARIES for named programs. */
+	if (exec_inject_env(imgp, inject_env, sizeof(inject_env))) {
+		printf("SWEET exec: %.*s gets %s\n",
+		    (int)imgp->ip_ndp->ni_cnd.cn_namelen,
+		    imgp->ip_ndp->ni_cnd.cn_nameptr, inject_env);
+		error = exec_add_user_string(imgp, CAST_USER_ADDR_T(inject_env),
+		    UIO_SYSSPACE, TRUE);
+		if (error) {
+			goto bad;
+		}
 	}
 
 	/* Save space for envv[] NULL terminator */
