name to confirm backboardd's dyld receives amfiFlags.  Only sweet_amfi.c.

--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -319,9 +319,10 @@
 		uint64_t allow = ~0ULL;
 		int error = copyin(arg, args, sizeof(args));
 
-		if (!(sweet_amfi_dyld_seen & 1)) {
-			sweet_amfi_dyld_seen |= 1;
-			printf("SWEET AMFI: dyld policy call 90 -> allow all\n");
+		{
+			char amfi_proc[32] = "";
+			proc_name(proc_pid(p), amfi_proc, sizeof(amfi_proc));
