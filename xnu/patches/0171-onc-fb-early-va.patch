 static vm_map_address_t sweet_early_mk_va = 0xBFEE0000UL;
 static vm_map_address_t sweet_early_log_va = 0xBFFA0000UL;
 
+/* 0171: expose the proven panel alias to AppleCLCD::present(). */
+static uint64_t sweet_early_fb_pa = 0;
+vm_address_t sweet_fb_early_va(void) { return (vm_address_t)sweet_early_fb_va; }
+uint64_t sweet_fb_early_pa(void) { return sweet_early_fb_pa; }
+vm_size_t sweet_fb_early_size(void) { return (vm_size_t)(3 * ARM_TT_L2_SIZE); }
