+		} else if (last > s->memory->getLength()) {
+			/*
+			 * 0175: the surface descriptor's length is often just
+			 * width*height*4, while bytesPerRow carries padding
+			 * (4608 vs 4500, 4544 vs 4500).  Comparing the last byte
+			 * of the *padded* layout against that length rejects every
+			 * frame, so nothing was ever copied and the panel kept
+			 * whatever iBoot left there.  Clamp the row count to what
+			 * the descriptor really holds instead of dropping the frame.
+			 */
+			uint64_t avail = s->memory->getLength();
+			uint64_t first = s->offset + (uint64_t)sy * s->bytesPerRow + (uint64_t)sx * 4;
+			uint64_t room = avail > first ? avail - first : 0;
+			uint64_t rowneed = (uint64_t)w * 4;
+			int32_t maxh = 0;
+
+			if (s->bytesPerRow != 0 && room >= rowneed) {
+				maxh = (int32_t)((room - rowneed) / s->bytesPerRow) + 1;
+			}
+			if (maxh <= 0) {
+				src = 0;
+			} else if (h > maxh) {
+				h = maxh;
+			}
+			{
