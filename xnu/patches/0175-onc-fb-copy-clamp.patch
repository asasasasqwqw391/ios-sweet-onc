+					    id, (int)(get32(b, 12)), (int)maxh,
+					    (unsigned long long)s->bytesPerRow,
+					    (unsigned long long)s->offset,
+					    (unsigned long long)avail,
+					    (unsigned long long)last,
+					    (unsigned long long)s->allocSize);
+				}
+			}
