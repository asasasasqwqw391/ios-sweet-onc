+/*
+ * 0179: which kernel address do we actually write the panel through?
+ *
+ * The video console writes through vinfo.v_baseaddr, a mapping built by
+ * ml_io_map_unmappable(), and those writes demonstrably reach the glass.
+ * The 0171 alias resolves to the same physical page (proved by logging both
+ * page numbers) but nothing written through it ever appeared on the panel.
+ * The remaining difference is the memory attributes: the alias block is built
+ * with CACHE_ATTRINDX_WRITECOMB, so the stores can stay in the cache -- our
+ * own read-back sees them, DRAM keeps the old bytes, and the display
+ * controller scans the old bytes.  sweetfb_vcva=1 (default) makes every
+ * panel write go through the console's mapping instead.
+ */
+static uintptr_t
+sweet_panel_dst(uintptr_t fallback)
+{
+	static int usevc = -1;
+
+	if (usevc < 0) {
+		uint32_t v = 1;
+
+		usevc = PE_parse_boot_argn("sweetfb_vcva", &v, sizeof(v)) ? (int)v : 1;
+		IOLog("SWEET FB: vcva=%d console va=0x%llx alias va=0x%llx\n",
+		    usevc, (unsigned long long)sweet_vc_fb_va(),
+		    (unsigned long long)sweet_fb_early_va());
+	}
+	if (usevc) {
+		vm_offset_t vc = sweet_vc_fb_va();
+
+		if (vc != 0) {
+			return (uintptr_t)vc;
+		}
+	}
+	return fallback;
+}
