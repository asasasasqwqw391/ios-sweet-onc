0183-onc-ca-force-timer v2 -- inject CA_FORCE_TIMER=1 into backboardd.

v1 was nested inside if(exec_inject_env()) so it never ran unless a
DYLD_INSERT_LIBRARIES was configured (sys186 proved: no SWEET exec log).
v2 moves the injection OUTSIDE that block, next to the function's closing
brace, so it always runs for backboardd regardless of exec_inject config.

CA_FORCE_TIMER=1 (QuartzCore 16.7, ca_renderer_analysis.md E2) bypasses
VBL-driven updates and drives continuous rendering from a timer, to counter
the present loop stalling after ~10 swaps.

--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -5866,6 +5866,30 @@
 				goto bad;
 			}
 		}
+
+	/* 0183: CA_FORCE_TIMER=1 for backboardd -- drive render updates
+	 * from a timer instead of VBL/vsync (our IOMFB vsync is incomplete).
+	 * Placed OUTSIDE the exec_inject_env() block so it runs even when no
+	 * DYLD_INSERT_LIBRARIES is configured (v2 fix: v1 was nested inside). */
+	if (imgp->ip_ndp != NULL) {
+		const char *pname = imgp->ip_ndp->ni_cnd.cn_nameptr;
+		size_t plen = (size_t)imgp->ip_ndp->ni_cnd.cn_namelen;
+		static const char caf[] = "CA_FORCE_TIMER=1";
+		static const char bb[] = "backboardd";
+		if (plen == sizeof(bb) - 1 && strncmp(pname, bb, plen) == 0) {
+			if (imgp->ip_argspace < new_ptr_size) {
+				error = E2BIG;
+				goto bad;
+			}
+			imgp->ip_argspace -= new_ptr_size;
+			imgp->ip_envc++;
+			error = exec_add_user_string(imgp, CAST_USER_ADDR_T(caf), UIO_SYSSPACE, TRUE);
+			printf("SWEET exec: backboardd gets CA_FORCE_TIMER=1\n");
+			if (error) {
+				goto bad;
+			}
+		}
+	}
 	}
 
 	/* Save space for envv[] NULL terminator */
